# ScienceBot - Environment Variables

# ============================================
# Public Variables (Exposed to Client)
# ============================================

# Formspree Form Endpoint
# Get your endpoint from https://formspree.io/
# Format: https://formspree.io/f/YOUR_FORM_ID
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/meegopdy

# ============================================
# Development Only Variables
# ============================================

# Allowed Hosts for Development (Optional)
# Comma-separated list of tunnel hosts for development
# Leave empty or remove for production
# Example: ALLOWED_HOSTS=abc123.tunnelmole.net,xyz789.tunnelmole.net
ALLOWED_HOSTS=

# ============================================
# Site Configuration
# ============================================

# Site URL (for SEO and social sharing)
PUBLIC_SITE_URL=

# Site Name
PUBLIC_SITE_NAME=ScienceBot
