---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import "../styles/redesign.css";
import {
	stats,
	logros,
	programas,
	proyectos,
	aliados,
	prensa,
	faq,
	ruta,
	waLink,
	contact,
} from "../data/site";

const title = "ScienceBot | Escuela de robótica del Guaviare";
const description =
	"Escuela de robótica de San José del Guaviare, Amazonía colombiana. Robótica, programación, impresión 3D y ciencia para niños y jóvenes desde 2020.";

const IMG = "/img/rediseno";
const trial = waLink("Hola ScienceBot, quiero una clase de prueba gratis");
const filtros = ["Todos", "Competencias", "Reconocimientos", "Estudiantes"];
---

<Layout title={title} description={description}>
	<Header />

	<main class="rd">
		<!-- HERO -->
		<section class="hero" aria-labelledby="hero-title">
			<svg class="hero__lines" aria-hidden="true" viewBox="0 0 1440 760" preserveAspectRatio="none">
				<g fill="none" stroke="#5FD38E" stroke-width="1.4">
					<path d="M-20 640 C 300 560, 520 720, 820 600 S 1300 500, 1480 580"></path>
					<path d="M-20 680 C 300 600, 520 760, 820 640 S 1300 540, 1480 620"></path>
					<path d="M-20 720 C 300 640, 520 800, 820 680 S 1300 580, 1480 660"></path>
					<path d="M-20 90 C 260 30, 600 150, 900 60 S 1300 10, 1480 80"></path>
				</g>
			</svg>
			<div class="rd-wrap rd-row hero__inner">
				<div class="rd-stack hero__copy">
					<span class="hero__pill">San José del Guaviare · Amazonía colombiana · desde 2020</span>
					<h1 id="hero-title">Del Guaviare al mundo: niños que construyen el futuro con robots</h1>
					<p class="hero__lead">
						Robótica, programación, impresión 3D y ciencia para niños y jóvenes. En nuestra sede, en
						colegios, en resguardos indígenas y en veredas sin internet.
					</p>
					<div class="hero__ctas">
						<a href={trial} class="rd-btn rd-btn--cta" target="_blank" rel="noopener noreferrer">Reservar clase de prueba gratis</a>
						<a href="#historia" class="rd-btn rd-btn--ghost-light">Conoce nuestra historia</a>
					</div>
					<ul class="hero__badges" aria-label="Reconocimientos">
						<li>FIRST LEGO League · Finalistas nacionales 2025</li>
						<li>Ella es Astronauta · Space Center Houston</li>
						<li>100 Nuevos Líderes de Colombia</li>
					</ul>
				</div>
				<div class="hero__media">
					<img src={`${IMG}/hero-equipo.webp`} alt="Niños de primaria sonríen alrededor de una mesa llena de piezas y su robot terminado" class="hero__img" width="1600" height="1066" fetchpriority="high" />
					<img src={`${IMG}/nina-robot.webp`} alt="Niña sostiene el robot que construyó" class="hero__inset" width="400" height="520" loading="lazy" />
					<div class="hero__float">
						<span class="hero__float-icon" aria-hidden="true">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20M2 12h20M12 2c3 3 3 17 0 20M12 2c-3 3-3 17 0 20"></path></svg>
						</span>
						<span>Conexiones con Australia, España, Argentina y Canadá</span>
					</div>
				</div>
			</div>
		</section>

		<!-- CIFRAS -->
		<section aria-label="ScienceBot en cifras" class="rd-section--white stats">
			<div class="rd-wrap stats__grid">
				{stats.map((s) => (
					<div>
						<div class:list={["stats__value", { "stats__value--accent": s.accent }]}>{s.value}</div>
						<div class="stats__label">{s.label}</div>
					</div>
				))}
			</div>
		</section>

		<!-- HISTORIA -->
		<section id="historia" class="rd-section">
			<div class="rd-wrap rd-row">
				<div class="story__media">
					<img src={`${IMG}/taller-comunidad.webp`} alt="Niños arman robots en el piso durante un taller comunitario" class="story__main" loading="lazy" />
					<img src={`${IMG}/comunidad-joven.webp`} alt="Joven muestra su robot de piezas en un taller" class="story__small" loading="lazy" />
					<div class="story__car">
						<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16V11l2-5h14l2 5v5"></path><path d="M3 16h18v2H3z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle></svg>
						<strong>Un Renault 4 rojo fue nuestra primera aula</strong>
					</div>
				</div>
				<div class="rd-stack">
					<span class="rd-kicker">Nuestra historia en 30 segundos</span>
					<h2 class="rd-h2">Un kit de robótica, cuatro niños y una pandemia</h2>
					<p class="rd-lead">
						En 2020, Tatiana Muñoz estaba de visita en el Guaviare cuando la pandemia le impidió volver a
						Argentina, donde estudiaba. Con un kit de robótica empezó a enseñar a cuatro niños. Muy pronto
						fueron más de 70.
					</p>
					<p class="rd-lead">
						Las primeras clases se dieron en un Renault 4 rojo convertido en aula móvil. Hoy ScienceBot tiene
						sede propia, siete profesores y lleva la robótica a resguardos indígenas, zonas rurales y
						comunidades de firmantes de paz.
					</p>
					<a href="/historia" class="link-arrow">Ver la línea de tiempo completa →</a>
				</div>
			</div>
		</section>

		<!-- FUNDADORA -->
		<section id="fundadora" class="rd-section rd-section--navy">
			<div class="rd-wrap rd-row">
				<figure class="founder__media">
					<div class="founder__grid">
						<img src={`${IMG}/tatiana-ceo.webp`} alt="Tatiana Muñoz en el aula de ScienceBot, frente a un mural de la NASA" class="founder__main" loading="lazy" />
						<img src={`${IMG}/tatiana-onu.webp`} alt="Tatiana Muñoz junto a un integrante de la Misión de la ONU en Colombia" class="founder__a" loading="lazy" />
						<img src={`${IMG}/aula-nasa.webp`} alt="Estudiantes trabajan bajo el mural de la NASA en el aula de ScienceBot" class="founder__b" loading="lazy" />
					</div>
					<figcaption>En el aula de ScienceBot y con la Misión de la ONU en Colombia.</figcaption>
				</figure>
				<div class="rd-stack founder__copy">
					<span class="rd-kicker">Conoce a la fundadora</span>
					<!-- TODO: confirmar ortografía: "Angie" (tati-bot) vs "Anguie" (timeline anterior) -->
					<h2 class="rd-h2">Angie Tatiana Muñoz González</h2>
					<p class="rd-lead">
						Ingeniera electrónica de la UNAD y educadora STEAM. Fundó ScienceBot en San José del Guaviare y es
						consultora de robótica educativa de WRO Colombia desde 2022.
					</p>
					<ul class="founder__facts">
						<li><strong>Ponente en la ONU</strong><span>Nueva York, marzo de 2025</span></li>
						<li><strong>100 Nuevos Líderes de Colombia</strong><span>Reconocimiento de El País, 2025</span></li>
						<li><strong>Mujeres Líderes</strong><span>Representó a Colombia en Washington</span></li>
						<li><strong>Robótica en todos los colegios</strong><span>Co-impulsora del Proyecto de Ley 199 de 2024 Cámara</span></li>
					</ul>
					<div class="hero__ctas">
						<a href="https://tati-bot.vercel.app/" class="rd-btn rd-btn--white" target="_blank" rel="noopener noreferrer">Charlas y consultoría con Tati</a>
						<a href="https://www.instagram.com/tati.bots/" class="rd-btn rd-btn--ghost-light" target="_blank" rel="noopener noreferrer">@tati.bots</a>
					</div>
				</div>
			</div>
		</section>

		<!-- LOGROS -->
		<section id="logros" class="rd-section rd-section--white">
			<div class="rd-wrap rd-stack" style="gap: 32px">
				<div class="logros__head">
					<div class="rd-stack" style="gap: 10px">
						<span class="rd-kicker">Logros</span>
						<h2 class="rd-h2">Del aula a los podios</h2>
					</div>
					<div class="rd-chip-group" role="group" aria-label="Filtrar logros" data-logros-filters hidden>
						{filtros.map((f, i) => (
							<button type="button" class="rd-chip" data-filter={f} aria-pressed={i === 0 ? "true" : "false"}>{f}</button>
						))}
					</div>
				</div>
				<div class="rd-grid" style="--min: 330px" data-logros>
					{logros.map((l) => (
						<article class="rd-card" data-kind={l.kind} style="background: var(--rd-bg); border: 0">
							<img src={l.image} alt={l.alt} class="rd-card__img" loading="lazy" />
							<div class="rd-card__body">
								<div style="display:flex;align-items:center;gap:10px">
									<span class:list={["rd-medal", { "rd-medal--1": l.medal === "gold" }]} aria-hidden="true">
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#14192E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="14" r="6"></circle><path d="M8.5 3 10 8.5M15.5 3 14 8.5"></path></svg>
									</span>
									<span class="rd-card__meta">{l.meta}</span>
								</div>
								<h3>{l.title}</h3>
								<p>{l.text}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- PROGRAMAS -->
		<section id="programas" class="rd-section">
			<div class="rd-wrap rd-stack" style="gap: 32px">
				<div class="rd-stack" style="gap: 12px; max-width: 720px">
					<span class="rd-kicker">Programas</span>
					<h2 class="rd-h2">Aprender a la medida de cada edad</h2>
					<p class="rd-lead">De las primeras piezas LEGO a Python, Arduino e impresión 3D.</p>
				</div>
				<div class="rd-grid" style="--min: 260px">
					{programas.map((p) => (
						<article class="rd-card">
							<img src={p.image} alt={p.alt} class="rd-card__img" style="height: 190px" loading="lazy" />
							<div class="rd-card__body">
								<span class="prog__age">{p.edad}</span>
								<h3>{p.title}</h3>
								<p>{p.text}</p>
								<span class="rd-card__meta">{p.modo}</span>
								<a href={p.href} class="link-arrow" style="font-size:15px">Ver curso →</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- PROYECTOS -->
		<section class="rd-section rd-section--white">
			<div class="rd-wrap rd-stack" style="gap: 32px">
				<div class="rd-stack" style="gap: 12px">
					<span class="rd-kicker" style="color: #2E7A22">Ciencia para el territorio</span>
					<h2 class="rd-h2">Proyectos que nacen del Guaviare</h2>
				</div>
				<div class="rd-grid" style="--min: 260px">
					{proyectos.map((pr) => (
						<article class="proj">
							<span class="proj__icon" style={`background:${pr.color}`} aria-hidden="true">
								<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={pr.icon}></path></svg>
							</span>
							<h3>{pr.href ? <a href={pr.href}>{pr.title}</a> : pr.title}</h3>
							<p>{pr.text}</p>
							<span class="rd-card__meta">{pr.estado}</span>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- GALERÍA -->
		<section aria-labelledby="galeria-title" class="rd-section" style="padding-bottom: 0">
			<div class="rd-wrap rd-stack" style="gap: 28px">
				<h2 id="galeria-title" class="rd-h2">Así se vive ScienceBot</h2>
				<div class="gallery">
					<img src={`${IMG}/vr.webp`} alt="Niña explora realidad virtual con un visor" class="gallery__tall" loading="lazy" />
					<img src={`${IMG}/equipo-lego.webp`} alt="Tres niños construyen juntos una grúa de piezas" class="gallery__wide" loading="lazy" />
					<img src={`${IMG}/amigos-robot.webp`} alt="Dos amigos muestran sus robots terminados" class="gallery__tall" loading="lazy" />
					<img src={`${IMG}/soldadura.webp`} alt="Dos estudiantes sueldan componentes electrónicos" loading="lazy" />
					<img src={`${IMG}/scratch-pantalla.webp`} alt="Estudiantes programan con bloques en pantalla" loading="lazy" />
				</div>
			</div>
		</section>

		<!-- PLASTIC MAKERS -->
		<section aria-labelledby="pm-title" class="rd-section">
			<div class="rd-wrap">
				<div class="pm-band">
					<div class="rd-stack" style="gap: 16px; flex: 1 1 360px; min-width: 0">
						<span class="rd-kicker" style="color: #BFE8CC">Un proyecto de ScienceBot</span>
						<h2 id="pm-title" class="rd-h2" style="color:#fff">Plastic Makers 3D</h2>
						<p class="rd-lead" style="color:#DDF1E3">
							Convertimos plástico reciclado en filamento para impresión 3D. Lo dirige Juan Esteban Gómez, el
							primer alumno de la escuela, y con él se imprimió la carcasa del barco robot Wept Life.
						</p>
						<a href="/plastic-makers-3d" class="rd-btn rd-btn--maker" style="align-self:flex-start">Conocer el proyecto</a>
					</div>
					<ol class="pm-steps">
						<li><strong>1 · Botella</strong><span>Acopio y lavado del PET</span></li>
						<li><strong>2 · Filamento</strong><span>Extrusión a bobina de rPET</span></li>
						<li class="pm-steps__last"><strong>3 · Objeto</strong><span>Impresión 3D en el aula</span></li>
					</ol>
				</div>
			</div>
		</section>

		<!-- BECAS -->
		<section id="becas" class="rd-section" style="padding-top: 0">
			<div class="rd-wrap becas">
				<div class="becas__card">
					<span class="becas__num">1.200</span>
					<h2 style="font-size: 32px; line-height: 1.15; font-weight: 800">niños y jóvenes estudian con beca</h2>
					<p class="rd-lead">
						Llevamos robótica al resguardo Jiw de Barrancón, al ETCR Colinas y a veredas sin conexión. Tu aporte
						hace que un niño más pueda construir su primer robot.
					</p>
					<!-- TODO: agregar qué cubre una beca y su valor -->
					<div class="hero__ctas">
						<a href={waLink("Quiero apadrinar una beca ScienceBot")} class="rd-btn rd-btn--cta" target="_blank" rel="noopener noreferrer">Apadrina una beca</a>
						<a href={`mailto:${contact.email}?subject=Alianza%20ScienceBot`} class="rd-btn rd-btn--ghost">Sé aliado</a>
					</div>
				</div>
				<img src={`${IMG}/nino-robot.webp`} alt="Niño sonriente muestra el robot que armó en un taller comunitario" class="becas__img" loading="lazy" />
			</div>
		</section>

		<!-- ALIADOS -->
		<section id="aliados" class="rd-section--white" style="padding: 72px 0">
			<div class="rd-wrap rd-stack" style="gap: 24px">
				<h2 style="font-size: 32px; font-weight: 800">Aliados</h2>
			</div>
			<div class="aliados" role="region" aria-label="Organizaciones aliadas">
				<ul class="aliados__track">
					{[0, 1, 2, 3].map((copia) => (
						<Fragment>
							{aliados.map((a) => (
								<li aria-hidden={copia > 0 ? "true" : undefined}>
									<img src={a.logo} alt={copia > 0 ? "" : a.nombre} loading="lazy" decoding="async" />
								</li>
							))}
						</Fragment>
					))}
				</ul>
			</div>
		</section>

		<!-- PRENSA + MAPA -->
		<section class="rd-section">
			<div class="rd-wrap rd-row" style="align-items: flex-start">
				<div class="rd-stack">
					<span class="rd-kicker">En los medios</span>
					<h2 class="rd-h2">Lo que dicen de nosotros</h2>
					{prensa.map((m) => (
						<a href={m.url} class="press" target="_blank" rel="noopener noreferrer">
							<span class="press__meta">{m.medio} · {m.fecha}</span>
							<span class="press__title">{m.title}</span>
						</a>
					))}
				</div>
				<figure class="route">
					<figcaption>
						<span class="route__title">Del Guaviare al mundo</span>
						<span class="route__sub">Hasta dónde han llevado sus robots nuestros estudiantes.</span>
					</figcaption>
					<ol class="route__list">
						{ruta.map((r, i) => (
							<li class="route__stop">
								<span class="route__rail" aria-hidden="true">
									<span class:list={["route__dot", { "route__dot--intl": r.intl, "route__dot--home": i === 0 }]}>{i + 1}</span>
									{i < ruta.length - 1 && <span class="route__line"></span>}
								</span>
								<span class="route__text">
									<strong>{r.city}</strong>
									<span>{r.what}</span>
								</span>
								<span class="route__year">{r.year}</span>
							</li>
						))}
					</ol>
					<div class="route__legend">
						<span><i class="route__key" aria-hidden="true"></i>Colombia</span>
						<span><i class="route__key route__key--intl" aria-hidden="true"></i>Internacional</span>
					</div>
				</figure>
			</div>
		</section>

		<!-- FAQ -->
		<section class="rd-section rd-section--white">
			<div class="rd-wrap rd-row" style="align-items: flex-start">
				<div class="rd-stack">
					<h2 class="rd-h2">Preguntas frecuentes</h2>
					<p class="rd-lead">¿Tienes otra pregunta? Escríbenos y te respondemos el mismo día.</p>
					<a href={trial} class="rd-btn rd-btn--cta" style="align-self:flex-start" target="_blank" rel="noopener noreferrer">Hablar por WhatsApp</a>
				</div>
				<div class="rd-stack" style="gap: 12px">
					{faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>
	</main>

	<Footer />
	<WhatsAppButton message="Hola ScienceBot, quiero información" />
</Layout>

<script>
	// Filtro de logros: sin JS se ven todas las tarjetas.
	const group = document.querySelector<HTMLElement>("[data-logros-filters]");
	const cards = document.querySelectorAll<HTMLElement>("[data-logros] [data-kind]");
	if (group) {
		group.hidden = false;
		group.addEventListener("click", (ev) => {
			const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("button[data-filter]");
			if (!btn) return;
			const f = btn.dataset.filter;
			group.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
			cards.forEach((c) => (c.hidden = f !== "Todos" && c.dataset.kind !== f));
		});
	}
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--rd-navy);
		color: #fff;
		margin-top: var(--rd-header-h);
	}
	.hero__lines { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0.16; }
	.hero__inner { position: relative; padding-top: clamp(56px, 8vw, 88px); padding-bottom: clamp(72px, 9vw, 104px); }
	.hero__copy { gap: 24px; }
	.hero__pill {
		align-self: flex-start;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		padding: 7px 14px;
		font-weight: 700;
		font-size: 14px;
	}
	.hero h1 { color: #fff; font-size: clamp(38px, 5.2vw, 62px); line-height: 1.03; font-weight: 800; letter-spacing: -0.025em; }
	.hero__lead { font-size: 20px; line-height: 1.55; color: #d3d9ee !important; max-width: 560px; }
	.hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
	.hero__badges { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; font-size: 13px; font-weight: 800; }
	.hero__badges li { background: #fff; color: var(--rd-ink); padding: 8px 12px; border-radius: 10px; }
	.hero__media { position: relative; }
	.hero__img { width: 100%; height: clamp(320px, 40vw, 500px); object-fit: cover; border-radius: 32px; }
	.hero__inset {
		position: absolute; right: -14px; bottom: -36px; width: 170px; height: 220px;
		object-fit: cover; object-position: center 30%; border-radius: 24px; border: 6px solid var(--rd-navy);
	}
	.hero__float {
		position: absolute; left: -18px; bottom: 30px; max-width: 280px;
		background: #fff; color: var(--rd-ink); border-radius: 18px; padding: 14px 18px;
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.28);
		display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 14px; line-height: 1.3;
	}
	.hero__float-icon { flex: none; width: 44px; height: 44px; border-radius: 50%; background: #2E8A23; display: flex; align-items: center; justify-content: center; }

	.stats { border-bottom: 1px solid var(--rd-border); }
	.stats__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 24px; padding-top: 44px; padding-bottom: 44px; }
	.stats__value { font-weight: 800; font-size: 46px; line-height: 1; color: var(--color-primary); }
	.stats__value--accent { color: var(--rd-cta); }
	.stats__label { font-weight: 800; margin-top: 6px; }

	.story__media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
	.story__main { grid-column: span 2; width: 100%; height: 300px; object-fit: cover; border-radius: 28px; }
