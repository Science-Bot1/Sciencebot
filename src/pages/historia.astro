---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import Timeline from "../components/timeline/Timeline.astro";
import "../styles/redesign.css";
import { timelineEvents } from "../data/timeline";
import { waLink } from "../data/site";

const title = "Nuestra historia | ScienceBot";
const description =
    "De un kit de robótica y cuatro niños en 2020 a más de 6.000 formados, la NASA y la ONU: la línea de tiempo de ScienceBot, escuela de robótica del Guaviare.";
---

<Layout title={title} description={description}>
    <Header />

    <main class="rd">
        <section class="h-hero">
            <img src="/img/rediseno/comunidad-joven.webp" alt="" class="h-hero__bg" />
            <div class="rd-wrap h-hero__inner rd-stack">
                <a href="/" class="h-hero__back">← Inicio</a>
                <h1>Nuestra historia</h1>
                <p>De un kit de robótica y cuatro niños en 2020 a más de 6.000 formados, la NASA y la ONU.</p>
            </div>
        </section>

        <Timeline events={timelineEvents} />

        <section class="rd-wrap" style="padding-bottom: 96px">
            <div class="h-cta">
                <div class="rd-stack" style="gap: 8px; max-width: 560px">
                    <h2 class="rd-h2" style="color: #fff">El futuro continúa…</h2>
                    <p style="color: #d3d9ee; font-size: 17px">El próximo hito puede tener el nombre de tu hija o tu hijo.</p>
                </div>
                <a href={waLink("Hola ScienceBot, quiero una clase de prueba gratis")} class="rd-btn rd-btn--cta" target="_blank" rel="noopener noreferrer">
                    Reservar clase de prueba gratis
                </a>
            </div>
        </section>
    </main>

    <Footer />
    <WhatsAppButton />
</Layout>

<style>
    .h-hero { position: relative; overflow: hidden; background: var(--rd-navy); color: #fff; margin-top: var(--rd-header-h); }
    .h-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.25; }
    .h-hero__inner { position: relative; padding-top: 72px; padding-bottom: 56px; gap: 16px; }
    .h-hero__back { color: #d3d9ee; font-weight: 700; align-self: flex-start; min-height: 32px; display: inline-flex; align-items: center; }
    .h-hero h1 { color: #fff; font-size: clamp(38px, 5vw, 56px); line-height: 1.05; font-weight: 800; }
    .h-hero p { color: #d3d9ee; font-size: 19px; line-height: 1.6; max-width: 640px; }
    .h-cta {
        background: var(--rd-navy); color: #fff; border-radius: 32px; padding: clamp(28px, 4vw, 48px);
        display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between;
    }
</style>
