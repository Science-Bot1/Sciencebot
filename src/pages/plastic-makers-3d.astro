---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import "../styles/redesign.css";
import { waLink, contact } from "../data/site";

const title = "Plastic Makers 3D | ScienceBot";
const description =
    "Jóvenes del Guaviare convierten botellas PET en filamento reciclado (rPET) para impresión 3D. Un proyecto de ScienceBot liderado por Juan Esteban Gómez.";

const IMG = "/img/rediseno";

const hitos = [
    { y: "2019", t: "Llega el primer alumno", d: "Juan Esteban Gómez entra a ScienceBot con nueve años.", c: "#2020E8" },
    { y: "2020", t: "Robots con botellas y cartón", d: "Los niños construyen manos y pies robóticos con material reciclado.", c: "#0B5E2E" },
    { y: "Fin 2022", t: "Sede propia e impresoras 3D", d: "La escuela abre su local y suma impresión 3D.", c: "#C5302A" },
    // TODO: confirmar con Tatiana / Juan Esteban el año en que nace Plastic Makers
    { y: "Hoy", t: "Nace Plastic Makers", d: "Del plástico reciclado al filamento y a objetos útiles.", c: "#F2A33A" },
    { y: "2025 – 2026", t: "Wept Life en la FILBo", d: "La carcasa impresa del barco robot llega a la Feria del Libro de Bogotá.", c: "#0B5E2E" },
];

const pasos = [
    { t: "Recolección", d: "Acopio de botellas PET.", icon: "M10 2h4v3l1.5 2v13a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2V7L10 5z" },
    { t: "Limpieza", d: "Lavado y selección.", icon: "M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z" },
    { t: "Trituración", d: "Corte en tiras o escamas.", icon: "M6 6l12 12M18 6 6 18" },
    { t: "Extrusión", d: "Calor controlado forma el hilo.", icon: "M3 12h12M15 8l4 4-4 4M7 6v12" },
    { t: "Enrollado", d: "Bobina de filamento rPET.", icon: "M12 4a8 8 0 1 0 0 16 8 8 0 1 0 0-16M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6" },
    { t: "Etiquetado", d: "Control y distribución.", icon: "M3 12V4h8l10 10-8 8z" },
    { t: "Impresión 3D", d: "Diseño y fabricación.", icon: "M12 3 3 8l9 5 9-5zM3 8v8l9 5 9-5V8" },
];

const rs = [
    ["Repensar", "Diseñar productos circulares desde el inicio"],
    ["Reducir", "Menos plástico virgen y energía"],
    ["Reutilizar", "Volver a usar lo que sirve"],
    ["Reparar", "Arreglar antes de desechar"],
    ["Restaurar", "Devolver al estado original"],
    ["Remanufacturar", "Piezas usadas, productos nuevos"],
    ["Reproponer", "Nuevo uso a lo desechado"],
    ["Reciclar", "PET convertido en filamento rPET"],
    ["Recuperar", "Valor o energía al final de la vida útil"],
];

const ONU =
    "https://colombia.un.org/es/322634-la-profesora-de-rob%C3%B3tica-que-les-ense%C3%B1a-los-ni%C3%B1os-del-guaviare-so%C3%B1ar-con-la-paz";
---

<Layout title={title} description={description}>
    <Header />

    <main class="rd pm">
        <!-- HERO -->
        <section class="pm-hero">
            <div class="rd-wrap rd-row pm-hero__inner">
                <div class="rd-stack" style="gap: 22px">
                    <a href="/" class="pm-hero__parent">
                        ← Un proyecto de
                        <span class="pm-hero__logo"><img src="/logo-sciencebot.png" alt="ScienceBot" width="64" height="28" /></span>
                    </a>
                    <h1>Plastic <span>Makers</span> 3D</h1>
                    <p class="pm-hero__lead">
                        Jóvenes del Guaviare convierten plástico reciclado en filamento para impresión 3D y fabrican desde
                        juguetes hasta la carcasa de un barco robot que cuida el agua.
                    </p>
                    <div class="pm-ctas">
                        <a href={waLink("Quiero cotizar una impresión 3D con Plastic Makers")} class="rd-btn rd-btn--maker" target="_blank" rel="noopener noreferrer">Cotizar impresión 3D</a>
                        <a href="#historia" class="rd-btn rd-btn--ghost-light">Conoce la historia</a>
                    </div>
                </div>
                <div class="pm-hero__media">
                    <img src={`${IMG}/pm-barco.webp`} alt="Carcasa del barco robot Wept Life impresa en 3D, con su electrónica y cables a la vista" fetchpriority="high" />
                    <div class="pm-hero__tag"><strong>Carcasa impresa con Plastic Makers</strong><span>Barco robot Wept Life</span></div>
                </div>
            </div>
        </section>

        <!-- HISTORIA -->
        <section id="historia" class="rd-section">
            <div class="rd-wrap rd-row">
                <figure class="pm-fig">
                    <!-- TODO: confirmar consentimiento de la familia para publicar nombre y foto (menor de edad) -->
                    <img src={`${IMG}/pm-juan-esteban.webp`} alt="Juan Esteban Gómez sostiene el barco robot Wept Life frente a las vitrinas de ScienceBot" loading="lazy" />
                    <figcaption>Juan Esteban Gómez con el barco robot Wept Life.</figcaption>
                </figure>
                <div class="rd-stack" style="flex: 1.2 1 480px">
                    <span class="rd-kicker" style="color: var(--rd-eco)">La historia</span>
                    <h2 class="rd-h2">Del primer alumno al líder del proyecto</h2>
                    <p class="rd-lead">
                        Juan Esteban Gómez fue el primer estudiante de ScienceBot: llegó en 2019, con nueve años y sin
                        saber nada de robótica. Hoy estudia programación en el SENA, es profesor de la escuela, consejero
                        de juventudes y dirige Plastic Makers.
                    </p>
                    <p class="rd-lead">
                        La idea de construir con lo que otros botan está en el ADN de la escuela: en 2020 los niños
                        llevaban botellas y cartón para armar manos y pies robóticos. Plastic Makers dio el siguiente
                        paso: transformar ese plástico en filamento para imprimir en 3D, en una región donde no había
                        servicio de impresión 3D ni filamento a la venta.
                    </p>
                    <blockquote class="pm-quote">
                        “Hoy estoy seguro de que quiero dedicar mi vida a la robótica.”
                        <footer>Juan Esteban Gómez, en <a href={ONU} target="_blank" rel="noopener noreferrer">ONU Colombia</a></footer>
                    </blockquote>
                </div>
            </div>
        </section>

        <!-- FERIAS -->
        <section aria-label="Plastic Maker 3D en ferias" style="padding-bottom: clamp(64px, 9vw, 104px)">
            <div class="rd-wrap pm-ferias">
                <img src={`${IMG}/pm-stand.webp`} alt="Estudiantes de ScienceBot en el stand de Plastic Maker 3D, con impresora 3D y piezas sobre la mesa" class="pm-ferias__tall" loading="lazy" />
                <div class="rd-stack" style="flex: 1.6 1 520px; gap: 20px">
                    <img src={`${IMG}/stand-impresoras.webp`} alt="Stand de ScienceBot en una feria con impresoras 3D y estudiantes mostrando sus piezas" class="pm-ferias__wide" loading="lazy" />
                    <div class="pm-note">
                        <strong>Plastic Maker 3D sale a la calle</strong>
                        <p>Los estudiantes llevan sus impresoras a ferias y muestran cómo una botella se convierte en filamento y en objetos útiles.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- HITOS -->
        <section class="rd-section--white" style="padding: 80px 0">
            <div class="rd-wrap rd-stack" style="gap: 28px">
                <h2 style="font-size: 34px; font-weight: 800">Cómo llegamos hasta aquí</h2>
                <ol class="pm-hitos">
                    {hitos.map((h) => (
                        <li style={`border-top-color:${h.c}`}>
                            <span class="pm-hitos__y">{h.y}</span>
                            <strong>{h.t}</strong>
                            <span>{h.d}</span>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <!-- PROCESO -->
        <section class="rd-section">
            <div class="rd-wrap rd-stack" style="gap: 36px">
                <div class="rd-stack" style="gap: 10px">
                    <span class="rd-kicker" style="color: var(--rd-eco)">El proceso</span>
                    <h2 class="rd-h2">De la botella a la impresora</h2>
                </div>
                <ol class="pm-pasos">
                    {pasos.map((s, i) => (
                        <li class:list={{ "pm-pasos__last": i === pasos.length - 1 }}>
                            <span class="pm-pasos__n">PASO {i + 1}</span>
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon}></path></svg>
                            <strong>{s.t}</strong>
                            <span>{s.d}</span>
                        </li>
                    ))}
                </ol>
                <p style="font-size: 14px; color: var(--rd-muted); max-width: 820px">
                    El PET reciclado se extruye como filamento rPET. No se convierte en PLA, que es otro polímero
                    elaborado a partir de almidón vegetal.
                </p>
            </div>
        </section>

        <!-- INVESTIGACIÓN -->
        <section class="rd-section rd-section--navy">
            <div class="rd-wrap rd-stack" style="gap: 32px">
                <div class="rd-stack" style="gap: 10px; max-width: 760px">
                    <span class="rd-kicker" style="color: #8FE0AE">Investigación aplicada</span>
                    <h2 class="rd-h2">Lo que se fabrica con Plastic Makers</h2>
                </div>
                <div class="pm-research">
                    <article class="pm-glass pm-research__main">
                        <span class="pm-tag">Proyecto insignia</span>
                        <h3>Wept Life: un barco robot para los humedales</h3>
                        <p>
                            Un mini barco que navega los humedales de San José del Guaviare y mide parámetros
                            fisicoquímicos del agua que beben comunidades indígenas. Envía los datos a una aplicación que
                            detecta cambios en la calidad del agua y posibles fuentes de contaminación.
                        </p>
                        <p>Su carcasa se imprimió en 3D con la técnica de Plastic Makers. Lo construyeron en equipo niños y jóvenes del Guaviare.</p>
                        <ul>
                            <li>Presentado ante MinCiencias</li>
                            <li>Feria del Libro de Bogotá, con el programa Colombia Robótica</li>
                            <li>Próxima parada: Perú</li>
                        </ul>
                    </article>
                    <div class="pm-research__side">
                        <div class="pm-glass" style="grid-column: span 2"><strong>Juguetes y prótesis</strong><p>El filamento sirve para imprimir desde juguetes hasta prótesis.</p></div>
                        <div class="pm-glass"><strong>Ingresos propios</strong><p>El proyecto se sostiene con lo que vende.</p></div>
                        <!-- TODO: agregar ficha técnica de la encuesta (muestra, fecha) -->
                        <div class="pm-glass"><strong>80 %</strong><p>de los encuestados usaría impresión 3D con material reciclado.</p></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 9R -->
        <section class="rd-section rd-section--white">
            <div class="rd-wrap rd-stack" style="gap: 32px">
                <div class="rd-stack" style="gap: 10px">
                    <span class="rd-kicker" style="color: var(--rd-eco)">Economía circular</span>
                    <h2 class="rd-h2">Las 9R en el aula</h2>
                </div>
                <ul class="pm-rs">
                    {rs.map(([t, d], i) => (
                        <li>
                            <span class="pm-rs__n">R{i + 1}</span>
                            <div><strong>{t}</strong><span>{d}</span></div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- MISIÓN -->
        <section class="rd-section">
            <div class="rd-wrap rd-row">
                <div class="rd-stack" style="gap: 14px">
                    <span class="rd-kicker" style="color: var(--rd-eco)">Misión y visión</span>
                    <p style="font-size: 24px; line-height: 1.4; font-weight: 700; color: var(--rd-ink)">
                        Promover la educación ambiental transformando el PET en filamento y en productos impresos en 3D.
                    </p>
                    <p class="rd-lead">
                        Queremos ser una empresa pionera en Colombia en la transformación de plástico reciclado para
                        impresión 3D: menos plástico en la selva, empleo local y tecnología para el Guaviare.
                    </p>
                </div>
                <div class="pm-photos">
                    <img src={`${IMG}/pm-impresora.webp`} alt="Estudiante revisa una impresora 3D mientras imprime" loading="lazy" />
                    <img src={`${IMG}/pm-filamento.webp`} alt="Joven junto a una impresora 3D con su bobina de filamento" style="object-position: center 25%" loading="lazy" />
                    <img src={`${IMG}/pluma-3d.webp`} alt="Niño dibuja en tres dimensiones con un lápiz 3D" loading="lazy" />
                    <!-- TODO: contador de botellas recicladas (dato configurable) -->
                    <div class="pm-counter"><span>Botellas</span><strong>que se vuelven piezas</strong></div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section style="padding-bottom: clamp(64px, 9vw, 104px)">
            <div class="rd-wrap rd-grid" style="--min: 280px">
                <article class="pm-cta pm-cta--dark">
                    <h3>Cotizar impresión y diseño 3D</h3>
                    <p>Piezas, prototipos y recuerdos en filamento reciclado.</p>
                    <a href={waLink("Quiero cotizar una impresión 3D")} class="rd-btn rd-btn--maker" target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
                </article>
                <article class="pm-cta pm-cta--eco">
                    <h3>Taller para mi colegio</h3>
                    <p>Reciclaje, diseño e impresión 3D para estudiantes y docentes.</p>
                    <a href={`mailto:${contact.email}?subject=Taller%20Plastic%20Makers`} class="rd-btn rd-btn--white">Solicitar taller</a>
                </article>
                <article class="pm-cta">
                    <h3>Donar botellas</h3>
                    <!-- TODO: horarios del punto de acopio -->
                    <p>Trae tus botellas PET limpias a la sede de ScienceBot en San José del Guaviare.</p>
                    <a href={waLink("Quiero donar botellas a Plastic Makers")} class="rd-btn rd-btn--ghost" target="_blank" rel="noopener noreferrer">Coordinar entrega</a>
                </article>
            </div>
        </section>
    </main>

    <Footer />
    <WhatsAppButton message="Hola, quiero información sobre Plastic Makers 3D" />
</Layout>

<style>
    .pm { background: var(--rd-eco-soft); }
    .pm-hero {
        position: relative; overflow: hidden; background: var(--rd-eco); color: #fff; margin-top: var(--rd-header-h);
        background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px);
        background-size: 50px 50px;
    }
    .pm-hero__inner { padding-top: clamp(56px, 8vw, 80px); padding-bottom: clamp(64px, 9vw, 88px); }
    .pm-hero__parent {
        align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; color: #fff; font-weight: 800; font-size: 14px;
        background: rgba(255,255,255,.12); padding: 8px 14px; border-radius: 999px; min-height: 40px;
    }
    .pm-hero__parent:hover { color: #fff; }
    .pm-hero__logo { background: #fff; border-radius: 8px; padding: 3px 6px; display: inline-flex; }
    .pm-hero__logo img { height: 22px; width: auto; }
    .pm-hero h1 { color: #fff; font-size: clamp(42px, 5.5vw, 64px); line-height: 1.02; font-weight: 800; letter-spacing: -0.025em; }
    .pm-hero h1 span { color: var(--rd-maker); }
    .pm-hero__lead { color: #ddf1e3 !important; font-size: 20px; line-height: 1.55; max-width: 540px; }
    .pm-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
    .pm-hero__media { position: relative; }
    .pm-hero__media img { width: 100%; height: clamp(300px, 36vw, 440px); object-fit: cover; border-radius: 32px; }
    .pm-hero__tag {
        position: absolute; left: -16px; bottom: 26px; background: #fff; color: var(--rd-ink); border-radius: 18px; padding: 14px 18px;
        box-shadow: 0 14px 30px rgba(0,0,0,.28); display: flex; flex-direction: column; gap: 2px; max-width: 270px;
    }
    .pm-hero__tag span { font-size: 13px; color: var(--rd-muted); }

    .pm-fig { margin: 0; flex: 1 1 380px; }
    .pm-fig img { width: 100%; height: 480px; object-fit: cover; border-radius: 32px; }
    .pm-fig figcaption { margin-top: 12px; font-size: 14px; color: var(--rd-muted); }
    .pm-quote { margin: 0; padding: 22px 26px; background: #fff; border-radius: 20px; font-weight: 600; font-size: 19px; line-height: 1.5; }
    .pm-quote footer { font-weight: 800; font-size: 14px; color: var(--rd-muted); margin-top: 10px; }

    .pm-ferias { display: flex; flex-wrap: wrap; gap: 20px; align-items: stretch; }
    .pm-ferias__tall { flex: 1 1 340px; min-width: 0; height: 460px; object-fit: cover; border-radius: 28px; }
    .pm-ferias__wide { width: 100%; height: 300px; object-fit: cover; border-radius: 28px; }
    .pm-note { background: #fff; border-radius: 22px; padding: 22px 24px; display: flex; flex-direction: column; gap: 6px; }
    .pm-note strong { font-size: 20px; }

    .pm-hitos { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .pm-hitos li { border-top: 4px solid; background: var(--rd-eco-soft); border-radius: 0 0 18px 18px; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; }
    .pm-hitos__y { font-weight: 800; font-size: 22px; color: var(--rd-eco); }
    .pm-hitos li > span:last-child { font-size: 14px; line-height: 1.5; color: var(--rd-body); }

    .pm-pasos { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
    .pm-pasos li { background: #fff; border: 1px solid #dce4d6; border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 8px; color: var(--rd-ink); }
    .pm-pasos li > span:last-child { font-size: 14px; line-height: 1.45; }
    .pm-pasos__n { font-weight: 800; font-size: 13px; opacity: 0.75; }
    .pm-pasos .pm-pasos__last { background: var(--rd-maker); border-color: var(--rd-maker); }

    .pm-research { display: flex; flex-wrap: wrap; gap: 32px; align-items: stretch; }
    .pm-glass { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14); border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 6px; }
    .pm-glass strong { font-size: 18px; color: #fff; }
    .pm-glass p { font-size: 15px; color: #c7cee6 !important; }
    .pm-research__main { flex: 1.4 1 520px; min-width: 0; padding: 32px; gap: 14px; border-radius: 28px; }
    .pm-research__main h3 { font-size: 30px; line-height: 1.1; font-weight: 800; color: #fff; }
    .pm-research__main p { font-size: 17px; line-height: 1.65; color: #d3d9ee !important; }
    .pm-research__main ul { padding-left: 20px; display: flex; flex-direction: column; gap: 6px; color: #fff; }
    .pm-research__side { flex: 1 1 340px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-content: start; }
    .pm-tag { align-self: flex-start; background: var(--rd-maker); color: var(--rd-ink); font-weight: 800; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; padding: 7px 10px; border-radius: 8px; }

    .pm-rs { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 14px; }
    .pm-rs li { background: var(--rd-eco-soft); border-radius: 18px; padding: 18px 20px; display: flex; gap: 14px; align-items: flex-start; }
    .pm-rs li div { display: flex; flex-direction: column; gap: 3px; }
    .pm-rs li div span { font-size: 14px; line-height: 1.45; color: var(--rd-muted); }
    .pm-rs__n { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--rd-eco); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; }

    .pm-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .pm-photos img { width: 100%; height: 220px; object-fit: cover; border-radius: 22px; }
    .pm-counter { background: var(--rd-eco); color: #fff; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; justify-content: center; gap: 4px; }
    .pm-counter span { font-weight: 800; font-size: 32px; line-height: 1; }

    .pm-cta { background: #fff; border: 1px solid #dce4d6; border-radius: 28px; padding: 32px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
    .pm-cta h3 { font-size: 24px; font-weight: 800; }
    .pm-cta .rd-btn { margin-top: 8px; }
    .pm-cta--dark { background: var(--rd-ink); border-color: var(--rd-ink); color: #fff; }
    .pm-cta--dark p { color: #d3d9ee !important; }
    .pm-cta--eco { background: var(--rd-eco); border-color: var(--rd-eco); color: #fff; }
    .pm-cta--eco p { color: #ddf1e3 !important; }

    @media (max-width: 640px) {
        .pm-hero__tag { position: static; margin-top: 14px; max-width: none; }
        .pm-fig img, .pm-ferias__tall { height: 340px; }
        .pm-research__side { grid-template-columns: 1fr; }
        .pm-research__side .pm-glass { grid-column: auto !important; }
    }
</style>
