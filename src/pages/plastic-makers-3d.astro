---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import FloatingNav from "../components/layout/FloatingNav.astro";
import Footer from "../components/layout/Footer.astro";
const title = "Plastic Makers 3D | ScienceBot";
const description =
    "Transformamos botellas PET recicladas en filamento PLA para impresión 3D, impulsando la economía circular y el desarrollo tecnológico en Colombia.";
---

<Layout title={title} description={description}>
    <Header />
    <FloatingNav />
    <main>
        <!-- ============================================================
			 1. HERO SECTION
		     ============================================================ -->
        <section class="pm-hero section-padding" id="inicio">
            <div class="container">
                <div class="pm-hero__content">
                    <div class="pm-hero__text">
                        <span class="pm-badge reveal"
                            >♻ Proyecto Sostenible</span
                        >
                        <h1 class="pm-hero__title reveal">
                            Plastic Makers 3D:<br />
                            <span class="gradient-text"
                                >Transformando plástico</span
                            ><br />
                            en innovación sostenible
                        </h1>
                        <p class="pm-hero__subtitle reveal">
                            Convertimos botellas PET recicladas en filamento PLA
                            para impresión 3D, impulsando la economía circular y
                            el desarrollo tecnológico en la región.
                        </p>
                        <div class="pm-hero__buttons reveal">
                            <a
                                href="#sobre-el-proyecto"
                                class="btn btn-primary btn-lg"
                            >
                                Conoce el proyecto
                            </a>
                            <a
                                href="/contacto"
                                class="btn btn-secondary btn-lg"
                            >
                                Contáctanos
                            </a>
                        </div>
                    </div>
                    <div class="pm-hero__visual reveal-right">
                        <div class="pm-flow">
                            <div class="pm-flow__item pm-flow__item--bottle">
                                <div class="pm-flow__icon">🍶</div>
                                <span>PET Reciclado</span>
                            </div>
                            <div class="pm-flow__arrow">→</div>
                            <div class="pm-flow__item pm-flow__item--filament">
                                <div class="pm-flow__icon">🧵</div>
                                <span>Filamento</span>
                            </div>
                            <div class="pm-flow__arrow">→</div>
                            <div class="pm-flow__item pm-flow__item--print">
                                <div class="pm-flow__icon">🖨️</div>
                                <span>Objeto 3D</span>
                            </div>
                        </div>
                        <div class="pm-hero__glow"></div>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 2. SOBRE EL PROYECTO
		     ============================================================ -->
        <section class="section-padding light-section" id="sobre-el-proyecto">
            <div class="container">
                <div class="pm-about">
                    <div class="pm-about__text reveal-left">
                        <span class="pm-section-label">Sobre el Proyecto</span>
                        <h2>¿Qué es Plastic Makers 3D?</h2>
                        <p>
                            Plastic Makers 3D es un proyecto que busca <strong
                                >transformar botellas de plástico PET recicladas
                                en filamento PLA</strong
                            > para impresión 3D. A través de este proceso se promueve
                            la economía circular, la educación ambiental y el acceso
                            a nuevas tecnologías de fabricación digital.
                        </p>
                        <p>
                            Nuestro objetivo es que la tecnología de impresión
                            3D esté disponible para instituciones educativas,
                            empresas y personas interesadas en crear objetos
                            innovadores a partir de materiales reciclados.
                        </p>
                    </div>
                    <div class="pm-about__stats reveal-right">
                        <div class="pm-stat-card">
                            <div class="pm-stat-card__num">PET</div>
                            <div class="pm-stat-card__label">
                                Plástico reciclado
                            </div>
                        </div>
                        <div class="pm-stat-card">
                            <div class="pm-stat-card__num">→</div>
                            <div class="pm-stat-card__label">
                                Transformado en
                            </div>
                        </div>
                        <div class="pm-stat-card pm-stat-card--accent">
                            <div class="pm-stat-card__num">PLA</div>
                            <div class="pm-stat-card__label">Filamento 3D</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 3. EL PROBLEMA
		     ============================================================ -->
        <section class="section-padding dark-section" id="el-problema">
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label pm-section-label--light"
                        >El Problema</span
                    >
                    <h2 style="color:#f1f5f9; margin-bottom: var(--space-4);">
                        El plástico PET: una crisis ambiental
                    </h2>
                    <p
                        style="color:#94a3b8; max-width:640px; margin: 0 auto var(--space-12);"
                    >
                        Actualmente el plástico PET representa uno de los
                        mayores problemas ambientales a nivel mundial.
                    </p>
                </div>
                <div class="pm-problem-grid stagger-children">
                    <div class="pm-problem-card">
                        <div class="pm-problem-card__icon">⏳</div>
                        <h4>100 – 1,000 años</h4>
                        <p>
                            Tiempo que tarda una botella PET en degradarse en la
                            naturaleza.
                        </p>
                    </div>
                    <div class="pm-problem-card">
                        <div class="pm-problem-card__icon">🇨🇴</div>
                        <h4>Solo 3 de cada 10</h4>
                        <p>
                            Botellas se reciclan en Colombia. El resto termina
                            en rellenos o ecosistemas.
                        </p>
                    </div>
                    <div class="pm-problem-card">
                        <div class="pm-problem-card__icon">🏜️</div>
                        <h4>Sin acceso tecnológico</h4>
                        <p>
                            En regiones como el Guaviare no existen servicios de
                            impresión 3D ni filamento PLA.
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 4. NUESTRA SOLUCIÓN
		     ============================================================ -->
        <section
            class="section-padding"
            id="solucion"
            style="background: var(--color-light-secondary);"
        >
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Nuestra Solución</span>
                    <h2>Transformamos residuos en innovación</h2>
                    <p class="pm-section-desc">
                        Plastic Makers 3D propone una solución sostenible de
                        extremo a extremo.
                    </p>
                </div>
                <div class="pm-process reveal">
                    {
                        [
                            { num: "01", label: "Recolección de botellas PET" },
                            { num: "02", label: "Limpieza y clasificación" },
                            { num: "03", label: "Transformación en filamento" },
                            { num: "04", label: "Producción de filamento PLA" },
                            { num: "05", label: "Creación de objetos 3D" },
                        ].map((step) => (
                            <div class="pm-process__step">
                                <div class="pm-process__num">{step.num}</div>
                                <div class="pm-process__label">
                                    {step.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
                <div class="pm-benefits stagger-children">
                    <div class="pm-benefit">
                        <span class="pm-benefit__icon">♻</span>
                        <span>Reducir residuos plásticos</span>
                    </div>
                    <div class="pm-benefit">
                        <span class="pm-benefit__icon">🌱</span>
                        <span>Promover economía circular</span>
                    </div>
                    <div class="pm-benefit">
                        <span class="pm-benefit__icon">🧠</span>
                        <span>Fomentar innovación y creatividad</span>
                    </div>
                    <div class="pm-benefit">
                        <span class="pm-benefit__icon">🏫</span>
                        <span>Apoyar educación tecnológica</span>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 5. PRODUCTOS Y SERVICIOS
		     ============================================================ -->
        <section class="section-padding light-section" id="productos">
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Productos y Servicios</span>
                    <h2>Todo lo que ofrecemos</h2>
                </div>
                <div class="pm-services stagger-children">
                    <div class="pm-service-card">
                        <div class="pm-service-card__icon">🧵</div>
                        <h3>Filamento PLA Reciclado</h3>
                        <p>
                            Materia prima sostenible para impresoras 3D,
                            producida a partir de botellas PET recicladas.
                        </p>
                    </div>
                    <div class="pm-service-card pm-service-card--featured">
                        <div class="pm-service-card__icon">🖨️</div>
                        <h3>Impresión 3D</h3>
                        <p>
                            Fabricación de objetos personalizados: maquetas,
                            prototipos, piezas funcionales y objetos
                            decorativos.
                        </p>
                    </div>
                    <div class="pm-service-card">
                        <div class="pm-service-card__icon">💻</div>
                        <h3>Diseño 3D</h3>
                        <p>
                            Creación de modelos digitales a la medida, según la
                            necesidad del cliente o institución.
                        </p>
                    </div>
                    <div class="pm-service-card">
                        <div class="pm-service-card__icon">📚</div>
                        <h3>Talleres Educativos</h3>
                        <p>
                            Capacitación en impresión 3D, diseño 3D, reciclaje y
                            economía circular para comunidades.
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 6. MERCADO Y OPORTUNIDAD
		     ============================================================ -->
        <section class="section-padding dark-section" id="mercado">
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label pm-section-label--light"
                        >Mercado y Oportunidad</span
                    >
                    <h2 style="color:#f1f5f9;">
                        Un mercado en explosivo crecimiento
                    </h2>
                    <p
                        style="color:#94a3b8; max-width:600px; margin: 0 auto var(--space-12);"
                    >
                        El mercado global de impresión 3D está creciendo
                        rápidamente, abriendo enormes oportunidades en Colombia.
                    </p>
                </div>
                <div class="pm-market-stats stagger-children">
                    <div class="pm-market-stat">
                        <div class="pm-market-stat__value">$255M</div>
                        <div class="pm-market-stat__label">
                            Tamaño actual del mercado de filamentos 3D
                        </div>
                    </div>
                    <div class="pm-market-stat pm-market-stat--arrow">
                        <div class="pm-market-stat__arrow">→</div>
                    </div>
                    <div class="pm-market-stat pm-market-stat--highlight">
                        <div class="pm-market-stat__value">$1,189M</div>
                        <div class="pm-market-stat__label">
                            Proyección futura del mercado
                        </div>
                    </div>
                    <div class="pm-market-stat">
                        <div class="pm-market-stat__value">25.8%</div>
                        <div class="pm-market-stat__label">
                            Tasa de crecimiento anual
                        </div>
                    </div>
                </div>
                <div class="pm-sectors reveal">
                    <p
                        style="color:#94a3b8; text-align:center; margin-bottom: var(--space-6);"
                    >
                        Sectores que más utilizan impresión 3D:
                    </p>
                    <div class="pm-sectors__pills">
                        {
                            [
                                "🎓 Educación",
                                "🏭 Industria",
                                "⚕️ Medicina",
                                "🏗️ Arquitectura",
                                "🎨 Diseño",
                            ].map((s) => (
                                <span class="pm-sector-pill">{s}</span>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 7. IMPACTO AMBIENTAL
		     ============================================================ -->
        <section
            class="section-padding"
            id="impacto"
            style="background: var(--color-light-secondary);"
        >
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Impacto Ambiental</span>
                    <h2 style="margin-bottom: var(--space-8);">
                        Transformando el futuro del planeta
                    </h2>
                </div>
                <div class="pm-impact-grid stagger-children">
                    <div class="pm-impact-item">
                        <div class="pm-impact-item__icon">🌍</div>
                        <p>Reducir contaminación por plástico</p>
                    </div>
                    <div class="pm-impact-item">
                        <div class="pm-impact-item__icon">♻</div>
                        <p>Reutilizar botellas PET</p>
                    </div>
                    <div class="pm-impact-item">
                        <div class="pm-impact-item__icon">👷</div>
                        <p>Generar empleo local</p>
                    </div>
                    <div class="pm-impact-item">
                        <div class="pm-impact-item__icon">🏫</div>
                        <p>Promover educación ambiental</p>
                    </div>
                    <div class="pm-impact-item">
                        <div class="pm-impact-item__icon">🚀</div>
                        <p>Impulsar tecnología en la región</p>
                    </div>
                </div>
                <div class="pm-9r reveal">
                    <h3>Las 9R de la Economía Circular</h3>
                    <p class="pm-9r__desc">
                        Nuestro modelo de producción sigue los principios de
                        sostenibilidad más avanzados para maximizar el ciclo de
                        vida del plástico.
                    </p>
                    <div class="pm-9r__grid">
                        {
                            [
                                {
                                    title: "Repensar",
                                    icon: "🧠",
                                    desc: "Rediseñar productos para la circularidad desde su concepción.",
                                },
                                {
                                    title: "Reducir",
                                    icon: "📉",
                                    desc: "Minimizar el uso de plástico virgen y energía.",
                                },
                                {
                                    title: "Reutilizar",
                                    icon: "♻️",
                                    desc: "Volver a usar productos en buen estado o darles otra función.",
                                },
                                {
                                    title: "Reparar",
                                    icon: "🔧",
                                    desc: "Arreglar y mantener antes de pensar en desechar.",
                                },
                                {
                                    title: "Restaurar",
                                    icon: "✨",
                                    desc: "Devolver el producto antiguo a su estado y calidad original.",
                                },
                                {
                                    title: "Remanufacturar",
                                    icon: "🏭",
                                    desc: "Crear nuevos productos a partir de piezas usadas.",
                                },
                                {
                                    title: "Reproponer",
                                    icon: "💡",
                                    desc: "Darle un nuevo uso a un producto desechado.",
                                },
                                {
                                    title: "Reciclar",
                                    icon: "🔄",
                                    desc: "Procesar el PET para convertirlo en filamento PLA.",
                                },
                                {
                                    title: "Recuperar",
                                    icon: "🔋",
                                    desc: "Recuperar energía o el valor del material al final de su vida.",
                                },
                            ].map((r, i) => (
                                <div class="pm-9r__card hover-glow">
                                    <div class="pm-9r__card-header">
                                        <div class="pm-9r__num">R{i + 1}</div>
                                        <div class="pm-9r__icon">{r.icon}</div>
                                    </div>
                                    <h4 class="pm-9r__title">{r.title}</h4>
                                    <p class="pm-9r__text">{r.desc}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 8. PROCESO DE PRODUCCIÓN
		     ============================================================ -->
        <section class="section-padding light-section" id="proceso">
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Proceso de Producción</span>
                    <h2>Del residuo al producto, paso a paso</h2>
                </div>
                <div class="pm-production stagger-children">
                    {
                        [
                            {
                                icon: "🍶",
                                step: "1",
                                label: "Recolección de botellas PET",
                            },
                            {
                                icon: "🧹",
                                step: "2",
                                label: "Limpieza y selección",
                            },
                            {
                                icon: "⚙️",
                                step: "3",
                                label: "Trituración del plástico",
                            },
                            {
                                icon: "🔥",
                                step: "4",
                                label: "Extrusión para crear filamento",
                            },
                            {
                                icon: "🧵",
                                step: "5",
                                label: "Enrollado del filamento",
                            },
                            {
                                icon: "📦",
                                step: "6",
                                label: "Etiquetado y distribución",
                            },
                            {
                                icon: "🖨️",
                                step: "7",
                                label: "Impresión de objetos 3D",
                            },
                        ].map((item) => (
                            <div class="pm-prod-step">
                                <div class="pm-prod-step__circle">
                                    <span class="pm-prod-step__num">
                                        {item.step}
                                    </span>
                                    <span class="pm-prod-step__icon">
                                        {item.icon}
                                    </span>
                                </div>
                                <p class="pm-prod-step__label">{item.label}</p>
                                <div class="pm-prod-step__connector" />
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
        <!-- ============================================================
			 9. VALIDACIÓN
		     ============================================================ -->
        <section
            class="section-padding"
            id="validacion"
            style="background: var(--color-primary-alpha-5);"
        >
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Validación del Proyecto</span
                    >
                    <h2>Respaldado por la comunidad</h2>
                </div>
                <div class="pm-validation">
                    <div class="pm-validation__callout reveal">
                        <div class="pm-validation__pct">80%</div>
                        <p>
                            de los encuestados usarían impresión 3D con material
                            reciclado si estuviera disponible en su región.
                        </p>
                    </div>
                    <div class="pm-validation__methods reveal-right">
                        <h4>El proyecto fue validado mediante:</h4>
                        <ul>
                            <li>
                                ✅ Pruebas de impresión 3D con material
                                reciclado
                            </li>
                            <li>✅ Encuestas a potenciales clientes</li>
                            <li>✅ Talleres educativos en comunidades</li>
                        </ul>
                        <h4 style="margin-top: var(--space-6);">
                            Demanda identificada en sectores:
                        </h4>
                        <ul>
                            <li>🎓 Sector educativo</li>
                            <li>🎭 Sector cultural</li>
                            <li>🏢 Sector empresarial</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 10. MISIÓN
		     ============================================================ -->
        <section class="section-padding dark-section" id="mision">
            <div class="container">
                <div class="pm-mision reveal">
                    <span class="pm-section-label pm-section-label--light"
                        >Misión</span
                    >
                    <blockquote class="pm-quote">
                        "Promover la educación ambiental mediante la
                        transformación del plástico PET en filamento y productos
                        impresos en 3D, fomentando la economía circular y el uso
                        responsable de la tecnología."
                    </blockquote>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 11. VISIÓN
		     ============================================================ -->
        <section
            class="section-padding"
            id="vision"
            style="background: var(--color-light-secondary);"
        >
            <div class="container">
                <div class="pm-vision reveal">
                    <span class="pm-section-label">Visión</span>
                    <blockquote class="pm-quote pm-quote--dark">
                        "Ser una empresa pionera en Colombia en la
                        transformación de plástico reciclado para impresión 3D,
                        generando impacto ambiental, social y tecnológico."
                    </blockquote>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 12. MODELO DE INGRESOS
		     ============================================================ -->
        <section class="section-padding light-section" id="modelo">
            <div class="container">
                <div class="text-center reveal">
                    <span class="pm-section-label">Modelo de Ingresos</span>
                    <h2>¿Cómo generamos valor?</h2>
                </div>
                <div class="pm-revenue stagger-children">
                    <div class="pm-revenue-card">
                        <div class="pm-revenue-card__icon">🧵</div>
                        <h4>Venta de filamento PLA</h4>
                        <p>
                            Filamento reciclado de alta calidad para impresoras
                            3D.
                        </p>
                    </div>
                    <div class="pm-revenue-card">
                        <div class="pm-revenue-card__icon">🖨️</div>
                        <h4>Servicios de impresión 3D</h4>
                        <p>
                            Fabricación de piezas y objetos según las
                            necesidades del cliente.
                        </p>
                    </div>
                    <div class="pm-revenue-card">
                        <div class="pm-revenue-card__icon">💻</div>
                        <h4>Diseño de modelos 3D</h4>
                        <p>
                            Modelado digital profesional para cualquier
                            proyecto.
                        </p>
                    </div>
                    <div class="pm-revenue-card">
                        <div class="pm-revenue-card__icon">📚</div>
                        <h4>Capacitaciones y talleres</h4>
                        <p>
                            Formación en impresión 3D, reciclaje y economía
                            circular.
                        </p>
                    </div>
                    <div class="pm-revenue-card">
                        <div class="pm-revenue-card__icon">🤝</div>
                        <h4>Acuerdos institucionales</h4>
                        <p>
                            Alianzas con instituciones educativas y empresas del
                            sector.
                        </p>
                    </div>
                </div>
            </div>
        </section>
        <!-- ============================================================
			 13. CONTACTO CTA
		     ============================================================ -->
        <section class="section-padding pm-cta-section" id="contacto">
            <div class="container">
                <div class="pm-cta reveal">
                    <h2>¿Quieres crear algo en 3D o apoyar el proyecto?</h2>
                    <p>
                        Estamos listos para trabajar contigo. Contáctanos y
                        descubre cómo podemos colaborar en proyectos sostenibles
                        e innovadores.
                    </p>
                    <a
                        href="/contacto"
                        class="btn btn-primary btn-lg pm-cta__btn"
                    >
                        Contáctanos ahora
                    </a>
                </div>
            </div>
        </section>
        <Footer />
    </main>
</Layout>
<style>
    /* ============================================================
   PLASTIC MAKERS 3D — Page Styles
   ============================================================ */
    /* ── Hero ── */
    .pm-hero {
        background: linear-gradient(
            135deg,
            var(--color-light) 0%,
            #eef2ff 100%
        );
        padding-top: calc(var(--header-height) + var(--space-16));
        overflow: hidden;
        position: relative;
    }
    .pm-hero__content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-16);
        align-items: center;
        min-height: 500px;
    }
    @media (max-width: 768px) {
        .pm-hero__content {
            grid-template-columns: 1fr;
            gap: var(--space-10);
        }
    }
    .pm-badge {
        display: inline-block;
        background: var(--color-primary-alpha-10);
        color: var(--color-primary);
        border: 1px solid var(--color-primary-alpha-20);
        border-radius: var(--radius-full);
        padding: var(--space-1) var(--space-4);
        font-size: var(--text-sm);
        font-weight: 600;
        margin-bottom: var(--space-6);
    }
    .pm-hero__title {
