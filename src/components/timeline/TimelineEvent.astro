---
import type { TimelineEvent, TimelineCategory } from "../../data/timeline.ts";
import { formatEventDateShort } from "../../data/timeline.ts";

interface Props {
    event: TimelineEvent;
    category: TimelineCategory;
    index: number;
    isLeft: boolean;
}

const { event, category, index, isLeft } = Astro.props;
const formattedDate = formatEventDateShort(event.date);
---

<div
    class={`timeline-event ${isLeft ? "timeline-event-left" : "timeline-event-right"} reveal`}
    data-category={event.category}
    style={`--category-color: ${category.color}; --animation-delay: ${index * 100}ms;`}
>
    <!-- Timeline Node -->
    <div class="timeline-node" style={`background: ${category.color};`}>
        <div class="timeline-node-pulse"></div>
        <span class="timeline-node-icon">{event.icon}</span>
    </div>

    <!-- Event Card -->
    <article class="timeline-card">
        <!-- Category Badge -->
        <div class="timeline-badge" style={`background: ${category.color};`}>
            <span class="timeline-badge-icon">{category.icon}</span>
            <span class="timeline-badge-text">{category.name}</span>
        </div>

        <!-- Date -->
        <time class="timeline-date" datetime={event.date}>
            {formattedDate}
        </time>

        <!-- Content -->
        <div class="timeline-content">
            <h3 class="timeline-title">
                {
                    event.featured && (
                        <span class="timeline-featured-star">⭐</span>
                    )
                }
                {event.title}
            </h3>
            <p class="timeline-description">{event.description}</p>

            {
                event.expandedContent && (
                    <details class="timeline-details">
                        <summary class="timeline-summary">
                            Ver más detalles
                        </summary>
                        <p class="timeline-expanded">{event.expandedContent}</p>
                    </details>
                )
            }

            {
                event.image && (
                    <div class="timeline-image">
                        <img
                            src={event.image}
                            alt={event.title}
                            loading="lazy"
                        />
                    </div>
                )
            }
        </div>

        {
            event.featured && (
                <div class="timeline-featured-banner">Destacado</div>
            )
        }
    </article>
</div>

<style>
    .timeline-event {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 40px 1fr;
        gap: var(--space-6);
        margin-bottom: var(--space-12);
        opacity: 0;
        transform: translateY(40px);
        transition:
            opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .timeline-event.active {
        opacity: 1;
        transform: translateY(0);
        transition-delay: var(--animation-delay);
    }

    /* Left-aligned events */
    .timeline-event-left {
        grid-template-areas: "card node empty";
    }

    .timeline-event-left .timeline-card {
        grid-area: card;
        transform-origin: right center;
    }

    .timeline-event-left .timeline-node {
        grid-area: node;
    }

    /* Right-aligned events */
    .timeline-event-right {
        grid-template-areas: "empty node card";
    }

    .timeline-event-right .timeline-card {
        grid-area: card;
        transform-origin: left center;
    }

    .timeline-event-right .timeline-node {
        grid-area: node;
    }

    /* Timeline Node */
    .timeline-node {
        position: relative;
        grid-area: node;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
            0 0 0 4px var(--color-light),
            0 0 20px rgba(0, 0, 0, 0.1);
        z-index: 2;
        transition: all var(--transition-base);
    }

    .timeline-event:hover .timeline-node {
        transform: scale(1.2);
        box-shadow:
            0 0 0 6px var(--color-light),
            0 0 30px var(--category-color);
    }

    .timeline-node-pulse {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid var(--category-color);
        animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        opacity: 0;
    }

    @keyframes pulse-ring {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }
        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .timeline-node-icon {
        font-size: 1.25rem;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    }

    /* Event Card */
    .timeline-card {
        position: relative;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: var(--radius-2xl);
        padding: var(--space-6);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(255, 255, 255, 0.8);
        transition: all var(--transition-base);
        overflow: hidden;
    }

    .timeline-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--category-color), transparent);
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .timeline-event:hover .timeline-card {
        transform: translateY(-4px) scale(1.02);
        box-shadow:
            var(--shadow-xl),
            0 0 30px rgba(0, 0, 0, 0.1);
        border-color: var(--category-color);
    }

    .timeline-event:hover .timeline-card::before {
        opacity: 1;
    }

    /* Category Badge */
    .timeline-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        color: white;
        font-size: var(--text-sm);
        font-weight: 600;
        margin-bottom: var(--space-3);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .timeline-badge-icon {
        font-size: 1rem;
    }

    .timeline-badge-text {
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Date */
    .timeline-date {
        display: block;
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-neutral-500);
        margin-bottom: var(--space-4);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Content */
    .timeline-content {
        position: relative;
    }

    .timeline-title {
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--color-dark);
        margin-bottom: var(--space-3);
        line-height: 1.3;
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .timeline-featured-star {
        font-size: 1.5rem;
        animation: rotate-star 4s linear infinite;
    }

    @keyframes rotate-star {
        0%,
        100% {
            transform: rotate(0deg);
        }
        25% {
            transform: rotate(-15deg);
        }
        75% {
            transform: rotate(15deg);
        }
    }

    .timeline-description {
        font-size: var(--text-base);
        color: var(--color-neutral-600);
        line-height: 1.6;
        margin-bottom: var(--space-4);
    }

    /* Expandable Details */
    .timeline-details {
        margin-top: var(--space-4);
        border-top: 1px solid var(--color-neutral-200);
        padding-top: var(--space-4);
    }

    .timeline-summary {
        cursor: pointer;
        font-weight: 600;
        color: var(--category-color);
        display: flex;
        align-items: center;
        gap: var(--space-2);
        transition: color var(--transition-base);
        user-select: none;
    }

    .timeline-summary:hover {
        color: var(--color-primary-dark);
    }

    .timeline-summary::before {
        content: "▶";
        display: inline-block;
        transition: transform var(--transition-base);
    }

    .timeline-details[open] .timeline-summary::before {
        transform: rotate(90deg);
    }

    .timeline-expanded {
        margin-top: var(--space-4);
        padding: var(--space-4);
        background: var(--color-neutral-100);
        border-radius: var(--radius-lg);
        font-size: var(--text-sm);
        line-height: 1.7;
        color: var(--color-neutral-700);
        animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Image */
    .timeline-image {
        margin-top: var(--space-4);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .timeline-image img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform var(--transition-slow);
    }

    .timeline-event:hover .timeline-image img {
        transform: scale(1.05);
    }

    /* Featured Banner */
    .timeline-featured-banner {
        position: absolute;
        top: var(--space-6);
        right: calc(var(--space-6) * -1);
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
        padding: var(--space-1) var(--space-8);
        font-size: var(--text-xs);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        transform: rotate(45deg);
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
        .timeline-event {
            grid-template-columns: 1fr 32px 1fr;
            gap: var(--space-4);
            margin-bottom: var(--space-10);
        }

        .timeline-node {
            width: 32px;
            height: 32px;
        }

        .timeline-node-icon {
            font-size: 1rem;
        }
    }

    @media (max-width: 768px) {
        .timeline-event,
        .timeline-event-left,
        .timeline-event-right {
            grid-template-columns: 32px 1fr;
            grid-template-areas: "node card";
            gap: var(--space-4);
            margin-bottom: var(--space-8);
        }

        .timeline-card {
            padding: var(--space-5);
        }

        .timeline-title {
            font-size: var(--text-xl);
        }

        .timeline-description {
            font-size: var(--text-sm);
        }

        .timeline-featured-banner {
            right: calc(var(--space-5) * -1);
            padding: var(--space-1) var(--space-6);
        }
    }

    @media (max-width: 480px) {
        .timeline-node {
            width: 28px;
            height: 28px;
        }

        .timeline-card {
            padding: var(--space-4);
        }

        .timeline-title {
            font-size: var(--text-lg);
        }
    }
</style>
