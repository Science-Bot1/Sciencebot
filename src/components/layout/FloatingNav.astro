---
// Detectar página actual para mostrar navegación relevante
const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/";
const isAcademyPage = currentPath === "/academia";

// Tipo para las secciones de navegación
interface NavSection {
    id: string;
    label: string;
    icon: string;
}

// Secciones según la página actual
let navSections: NavSection[];

if (isHomePage) {
    // Home (Timeline) - sin menú flotante
    navSections = [];
} else if (isAcademyPage) {
    // Página Academia - secciones originales
    navSections = [
        {
            id: "courses",
            label: "Cursos",
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
        },
        {
            id: "benefits",
            label: "Beneficios",
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
        },
        {
            id: "testimonials",
            label: "Testimonios",
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
        },
        {
            id: "ceo",
            label: "Nosotros",
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
        },
        {
            id: "faq",
            label: "FAQ",
            icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        },
    ];
} else {
    // Otras páginas - navegación básica
    navSections = [];
}
---

<nav class="floating-nav" aria-label="Navegación de secciones">
    <ul class="floating-nav__list">
        {
            navSections.map((section) => (
                <li>
                    <button
                        class="floating-nav__item"
                        data-section={section.id}
                        aria-label={`Ir a ${section.label}`}
                        aria-current="false"
                    >
                        <span
                            class="floating-nav__icon"
                            set:html={section.icon}
                        />
                        <span class="floating-nav__label">{section.label}</span>
                    </button>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .floating-nav {
        position: fixed;
        right: var(--space-6);
        top: 50%;
        transform: translateY(-50%);
        z-index: var(--z-sticky);
        display: none;
    }

    @media (min-width: 1280px) {
        .floating-nav {
            display: block;
        }
    }

    .floating-nav__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .floating-nav__item {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-full);
        cursor: pointer;
        transition: all var(--transition-base);
        box-shadow: var(--shadow-sm);
    }

    .floating-nav__item:hover {
        background: white;
        border-color: var(--color-primary);
        transform: translateX(-4px);
        box-shadow: var(--shadow-md);
    }

    .floating-nav__item[aria-current="true"] {
        background: var(--gradient-primary);
        border-color: transparent;
        color: white;
    }

    .floating-nav__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        color: var(--color-neutral-500);
        transition: color var(--transition-fast);
    }

    .floating-nav__item:hover .floating-nav__icon,
    .floating-nav__item[aria-current="true"] .floating-nav__icon {
        color: currentColor;
    }

    .floating-nav__item[aria-current="true"] .floating-nav__icon {
        color: white;
    }

    .floating-nav__label {
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-neutral-600);
        white-space: nowrap;
        max-width: 0;
        overflow: hidden;
        opacity: 0;
        transition: all var(--transition-base);
    }

    .floating-nav__item:hover .floating-nav__label {
        max-width: 100px;
        opacity: 1;
        margin-right: var(--space-1);
    }

    .floating-nav__item[aria-current="true"] .floating-nav__label {
        max-width: 100px;
        opacity: 1;
        margin-right: var(--space-1);
        color: white;
    }
</style>

<script>
    const floatingNavItems = document.querySelectorAll(".floating-nav__item");
    const sections = document.querySelectorAll("section[id]");

    // Click handler for navigation
    floatingNavItems.forEach((item) => {
        item.addEventListener("click", () => {
            const sectionId = item.getAttribute("data-section");
            if (sectionId) {
                const section = document.getElementById(sectionId);
                if (section) {
                    const headerHeight = 72;
                    const targetPosition =
                        section.getBoundingClientRect().top +
                        window.scrollY -
                        headerHeight;
                    window.scrollTo({
                        top: targetPosition,
                        behavior: "smooth",
                    });
                }
            }
        });
    });

    // Scroll spy
    const observerOptions = {
        root: null,
        rootMargin: "-50% 0px -50% 0px",
        threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                floatingNavItems.forEach((item) => {
                    const isActive = item.getAttribute("data-section") === id;
                    item.setAttribute("aria-current", isActive.toString());
                });
            }
        });
    }, observerOptions);

    sections.forEach((section) => {
        observer.observe(section);
    });
</script>
