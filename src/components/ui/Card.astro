---
interface Props {
    variant?: "default" | "glass" | "dark" | "gradient";
    padding?: "sm" | "md" | "lg";
    hover?: boolean;
    class?: string;
}

const {
    variant = "default",
    padding = "md",
    hover = true,
    class: className = "",
} = Astro.props;

const paddingClasses = {
    sm: "card--padding-sm",
    md: "card--padding-md",
    lg: "card--padding-lg",
};

const classes = [
    "card",
    `card--${variant}`,
    paddingClasses[padding],
    hover ? "card--hover" : "",
    className,
]
    .filter(Boolean)
    .join(" ");
---

<div class={classes}>
    <slot />
</div>

<style>
    .card {
        position: relative;
        border-radius: var(--radius-xl);
        transition: all var(--transition-slow);
        overflow: hidden;
    }

    /* Padding */
    .card--padding-sm {
        padding: var(--space-4);
    }

    .card--padding-md {
        padding: var(--space-6);
    }

    .card--padding-lg {
        padding: var(--space-8);
    }

    /* Variants */
    .card--default {
        background: white;
        border: 1px solid var(--color-neutral-200);
        box-shadow: var(--shadow-sm);
    }

    .card--glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .card--dark {
        background: var(--color-dark-secondary);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
    }

    .card--gradient {
        background: linear-gradient(
            135deg,
            rgba(26, 26, 230, 0.1) 0%,
            rgba(124, 58, 237, 0.1) 100%
        );
        border: 1px solid rgba(26, 26, 230, 0.2);
    }

    /* Hover Effects */
    .card--hover.card--default:hover {
        border-color: var(--color-primary);
        box-shadow: var(--shadow-lg);
        transform: translateY(-4px);
    }

    .card--hover.card--glass:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.3);
        transform: translateY(-4px);
    }

    .card--hover.card--dark:hover {
        border-color: var(--color-primary);
        box-shadow: 0 0 30px rgba(26, 26, 230, 0.2);
        transform: translateY(-4px);
    }

    .card--hover.card--gradient:hover {
        border-color: var(--color-primary);
        box-shadow:
            var(--shadow-lg),
            0 0 30px rgba(26, 26, 230, 0.15);
        transform: translateY(-4px);
    }

    @media (max-width: 768px) {
        .card--padding-lg {
            padding: var(--space-6);
        }
    }
</style>
