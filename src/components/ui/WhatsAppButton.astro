---
import { waLink } from "../../data/site";

interface Props {
    message?: string;
}
const { message = "Hola ScienceBot, quiero información" } = Astro.props;
---

<a href={waLink(message)} class="rd-wa" aria-label="Escríbenos por WhatsApp" target="_blank" rel="noopener noreferrer">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.1A8.5 8.5 0 1 1 21 11.5z"></path>
    </svg>
</a>
