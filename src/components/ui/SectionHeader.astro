---
interface Props {
    label?: string;
    title: string;
    subtitle?: string;
    align?: "left" | "center";
    dark?: boolean;
    class?: string;
}

const {
    label,
    title,
    subtitle,
    align = "center",
    dark = false,
    class: className = "",
} = Astro.props;
---

<div
    class={`section-header section-header--${align} ${dark ? "section-header--dark" : ""} reveal ${className}`}
>
    {label && <span class="section-header__label">{label}</span>}
    <h2 class="section-header__title" set:html={title} />
    {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</div>

<style>
    .section-header {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-12);
    }

    .section-header--center {
        align-items: center;
        text-align: center;
    }

    .section-header--left {
        align-items: flex-start;
        text-align: left;
    }

    .section-header__label {
        display: inline-block;
        padding: var(--space-2) var(--space-4);
        background: var(--gradient-primary);
        color: white;
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-radius: var(--radius-full);
    }

    .section-header--dark .section-header__label {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .section-header__title {
        font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--color-dark);
        max-width: 20ch;
    }

    .section-header--center .section-header__title {
        max-width: 24ch;
        margin: 0 auto;
    }

    .section-header--dark .section-header__title {
        color: white;
    }

    .section-header__title :global(.gradient-text) {
        background: var(--gradient-text);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .section-header__title :global(.italic) {
        font-style: italic;
        font-weight: 400;
    }

    .section-header__subtitle {
        font-size: var(--text-lg);
        color: var(--color-neutral-500);
        max-width: 60ch;
        margin: 0;
    }

    .section-header--dark .section-header__subtitle {
        color: var(--color-neutral-400);
    }

    @media (max-width: 768px) {
        .section-header {
            margin-bottom: var(--space-8);
        }
    }
</style>
