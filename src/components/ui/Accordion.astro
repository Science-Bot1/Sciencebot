---
interface Props {
    title: string;
    icon?: string;
    open?: boolean;
    dark?: boolean;
    class?: string;
}

const {
    title,
    icon,
    open = false,
    dark = false,
    class: className = "",
} = Astro.props;
const darkClass = dark ? "accordion--dark" : "";
---

<details class={`accordion ${darkClass} ${className}`} open={open}>
    <summary class="accordion__trigger">
        <div class="accordion__header">
            {icon && <span class="accordion__icon" set:html={icon} />}
            <span class="accordion__title">{title}</span>
        </div>
        <svg
            class="accordion__chevron"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="m6 9 6 6 6-6"></path>
        </svg>
    </summary>
    <div class="accordion__content">
        <div class="accordion__body">
            <slot />
        </div>
    </div>
</details>

<style>
    .accordion {
        background: var(--color-neutral-100);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-xl);
        overflow: hidden;
        transition: all var(--transition-base);
    }

    .accordion:hover {
        border-color: var(--color-primary);
    }

    .accordion__trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        width: 100%;
        padding: var(--space-5) var(--space-6);
        cursor: pointer;
        list-style: none;
        user-select: none;
    }

    .accordion__trigger::-webkit-details-marker {
        display: none;
    }

    .accordion__header {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .accordion__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: var(--radius-lg);
        background: var(--gradient-primary);
        color: white;
        flex-shrink: 0;
    }

    .accordion__icon :global(svg) {
        width: 20px;
        height: 20px;
    }

    .accordion__title {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-dark);
    }

    .accordion__chevron {
        width: 24px;
        height: 24px;
        color: var(--color-neutral-500);
        transition: transform var(--transition-base);
        flex-shrink: 0;
    }

    .accordion[open] .accordion__chevron {
        transform: rotate(180deg);
    }

    .accordion__content {
        overflow: hidden;
    }

    .accordion__body {
        padding: 0 var(--space-6) var(--space-6);
        color: var(--color-neutral-600);
        line-height: 1.7;
    }

    /* Animation for content */
    .accordion[open] .accordion__content {
        animation: accordionOpen 0.3s ease forwards;
    }

    @keyframes accordionOpen {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Dark variant */
    .accordion.accordion--dark {
        background: #0f1115;
        border-color: #ffffff1a;
    }

    .accordion.accordion--dark:hover {
        background: #1f2a3a;
    }

    .accordion.accordion--dark .accordion__title {
        color: white;
    }

    .accordion.accordion--dark .accordion__body {
        color: var(--color-neutral-300);
    }

    @media (max-width: 768px) {
        .accordion__trigger {
            padding: var(--space-4);
        }

        .accordion__title {
            font-size: var(--text-base);
        }

        .accordion__body {
            padding: 0 var(--space-4) var(--space-4);
        }
    }
</style>

<script>
    // Smooth open/close animation
    document.querySelectorAll(".accordion").forEach((accordion) => {
        accordion.addEventListener("toggle", (e) => {
            const details = e.target as HTMLDetailsElement;
            if (details.open) {
                details.classList.add("is-open");
            } else {
                details.classList.remove("is-open");
            }
        });
    });
</script>
