---
// HomeHero.astro - Hero section for Home page

const techIcons = [
    { name: "Robot", delay: "0s", x: "10%", y: "20%" },
    { name: "Code", delay: "0.5s", x: "85%", y: "15%" },
    { name: "Chip", delay: "1s", x: "5%", y: "70%" },
    { name: "Gear", delay: "1.5s", x: "90%", y: "65%" },
    { name: "Lego", delay: "2s", x: "15%", y: "50%" },
    { name: "Lego", delay: "2.5s", x: "80%", y: "40%" },
];
---

<section id="home-hero" class="home-hero">
    <!-- Background Elements -->
    <div class="home-hero__background">
        <div class="home-hero__gradient"></div>
        <div class="home-hero__grid"></div>

        <!-- Floating Tech Icons -->
        {
            techIcons.map((icon) => (
                <div
                    class="home-hero__floating-icon"
                    style={`left: ${icon.x}; top: ${icon.y}; animation-delay: ${icon.delay};`}
                    aria-hidden="true"
                >
                    <svg
                        width="40"
                        height="40"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        {icon.name === "Robot" && (
                            <>
                                <rect
                                    x="3"
                                    y="11"
                                    width="18"
                                    height="10"
                                    rx="2"
                                />
                                <circle cx="8.5" cy="16" r="1.5" />
                                <circle cx="15.5" cy="16" r="1.5" />
                                <path d="M12 11V8" />
                                <circle cx="12" cy="5" r="3" />
                            </>
                        )}
                        {icon.name === "Code" && (
                            <>
                                <polyline points="16,18 22,12 16,6" />
                                <polyline points="8,6 2,12 8,18" />
                            </>
                        )}
                        {icon.name === "Chip" && (
                            <>
                                <rect
                                    x="4"
                                    y="4"
                                    width="16"
                                    height="16"
                                    rx="2"
                                />
                                <rect x="9" y="9" width="6" height="6" />
                                <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
                            </>
                        )}
                        {icon.name === "Gear" && (
                            <>
                                <circle cx="12" cy="12" r="3" />
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                            </>
                        )}
                        {icon.name === "Lego" && (
                            <>
                                <rect
                                    x="1"
                                    y="14"
                                    width="22"
                                    height="8"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                <rect
                                    x="2"
                                    y="6"
                                    width="8"
                                    height="9"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                <rect
                                    x="12"
                                    y="2"
                                    width="10"
                                    height="13"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                <rect
                                    x="4"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="10"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="17"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="4"
                                    y="3.5"
                                    width="2"
                                    height="2"
                                    rx="0.6"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="7.5"
                                    y="3.5"
                                    width="2"
                                    height="2"
                                    rx="0.6"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="14"
                                    y="0"
                                    width="2"
                                    height="1.5"
                                    rx="0.5"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="18"
                                    y="0"
                                    width="2"
                                    height="1.5"
                                    rx="0.5"
                                    stroke-width="1.5"
                                />
                                <line
                                    x1="5"
                                    y1="18"
                                    x2="10"
                                    y2="18"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </>
                        )}
                    </svg>
                </div>
            ))
        }
    </div>

    <div class="home-hero__container container">
        <div class="home-hero__content reveal">
            <!-- Main Headline -->
            <h1 class="home-hero__title">
                Inspirando a la <span class="gradient-text"
                    >próxima generación</span
                >
            </h1>

            <!-- Descriptive Text -->
            <p class="home-hero__description">
                Explora los hitos increíbles alcanzados por nuestros
                estudiantes. Desde competencias nacionales hasta soluciones
                innovadoras que están cambiando el mundo.
            </p>

            <!-- Decorative Stats -->
            <div class="home-hero__highlights">
                <div class="home-hero__highlight">
                    <div class="home-hero__highlight-icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
                            ></path>
                        </svg>
                    </div>
                    <span>Logros Nacionales</span>
                </div>
                <div class="home-hero__highlight">
                    <div class="home-hero__highlight-icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M12 2L2 7L12 12L22 7L12 2Z"></path>
                            <path d="M2 17L12 22L22 17"></path>
                            <path d="M2 12L12 17L22 12"></path>
                        </svg>
                    </div>
                    <span>Proyectos Innovadores</span>
                </div>
                <div class="home-hero__highlight">
                    <div class="home-hero__highlight-icon">
                        <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                d="M17 21V19C17 17.9391 16.5786 16.9217 15.8284 16.1716C15.0783 15.4214 14.0609 15 13 15H5C3.93913 15 2.92172 15.4214 2.17157 16.1716C1.42143 16.9217 1 17.9391 1 19V21"
                            ></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path
                                d="M23 21V19C22.9993 18.1137 22.7044 17.2528 22.1614 16.5523C21.6184 15.8519 20.8581 15.3516 20 15.13"
                            ></path>
                            <path
                                d="M16 3.13C16.8604 3.35031 17.623 3.85071 18.1676 4.55232C18.7122 5.25392 19.0078 6.11683 19.0078 7.005C19.0078 7.89318 18.7122 8.75608 18.1676 9.45769C17.623 10.1593 16.8604 10.6597 16 10.88"
                            ></path>
                        </svg>
                    </div>
                    <span>Comunidad Global</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="home-hero__scroll">
        <div class="home-hero__scroll-arrow">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
        </div>
    </div>
</section>

<style>
    /* Home Hero Section */
    .home-hero {
        position: relative;
        min-height: 90vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-top: calc(var(--header-height) + var(--space-8));
        padding-bottom: var(--space-16);
    }

    /* Background */
    .home-hero__background {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
    }

    .home-hero__gradient {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse 100% 60% at 50% 0%,
            var(--color-primary-alpha-10) 0%,
            transparent 70%
        );
    }

    .home-hero__grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--color-primary-alpha-5) 1px, transparent 1px),
            linear-gradient(
                90deg,
                var(--color-primary-alpha-5) 1px,
                transparent 1px
            );
        background-size: 60px 60px;
        mask-image: radial-gradient(
            ellipse 90% 70% at 50% 40%,
            black 0%,
            transparent 80%
        );
    }

    .home-hero__floating-icon {
        position: absolute;
        color: var(--color-primary-light);
        opacity: 0.15;
        animation: float 4s ease-in-out infinite;
    }

    /* Container */
    .home-hero__container {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
    }

    /* Content */
    .home-hero__content {
        max-width: 900px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
        padding: var(--space-8) 0;
    }

    .home-hero__title {
        font-size: clamp(var(--text-4xl), 7vw, var(--text-7xl));
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.03em;
        color: var(--color-dark);
        margin-bottom: var(--space-4);
    }

    .home-hero__description {
        font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
        line-height: 1.6;
        color: var(--color-neutral-600);
        max-width: 700px;
        margin: 0 auto;
    }

    /* Highlights */
    .home-hero__highlights {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-6);
        justify-content: center;
        margin-top: var(--space-6);
    }

    .home-hero__highlight {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-6);
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-full);
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-neutral-700);
        transition: all var(--transition-base);
    }

    .home-hero__highlight:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
        background: rgba(255, 255, 255, 0.9);
        border-color: var(--color-primary-light);
    }

    .home-hero__highlight-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: var(--color-primary-alpha-10);
        border-radius: 50%;
        color: var(--color-primary);
        flex-shrink: 0;
    }

    .home-hero__highlight-icon svg {
        width: 18px;
        height: 18px;
    }

    /* Scroll Indicator */
    .home-hero__scroll {
        position: absolute;
        bottom: var(--space-8);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-primary);
        font-size: var(--text-sm);
        font-weight: 500;
        z-index: 1;
    }

    .home-hero__scroll-arrow {
        animation: bounce-arrow 2s ease-in-out infinite;
        color: var(--color-primary);
    }

    @keyframes bounce-arrow {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(8px);
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .home-hero {
            min-height: 85vh;
            padding-top: calc(var(--header-height) + var(--space-6));
        }

        .home-hero__content {
            gap: var(--space-6);
        }

        .home-hero__highlights {
            gap: var(--space-4);
        }

        .home-hero__highlight {
            padding: var(--space-3) var(--space-4);
            font-size: var(--text-xs);
        }

        .home-hero__highlight-icon {
            width: 32px;
            height: 32px;
        }

        .home-hero__highlight-icon svg {
            width: 16px;
            height: 16px;
        }
    }

    @media (max-width: 480px) {
        .home-hero__floating-icon {
            display: none;
        }

        .home-hero__scroll {
            bottom: var(--space-4);
        }
    }
</style>

<script>
    // Scroll reveal animation
    document.addEventListener("DOMContentLoaded", () => {
        const reveals = document.querySelectorAll(".reveal");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    }
                });
            },
            { threshold: 0.1 },
        );

        reveals.forEach((el) => observer.observe(el));
    });
</script>
