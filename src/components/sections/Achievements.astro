---
// Achievements.astro - Showcase student achievements and experiences

const achievements = [
    {
        id: 1,
        image: "/achievement_competition_1770214975310.png",
        category: "Competencias",
        title: "Campeones Nacionales de Robótica",
        description:
            "Nuestros estudiantes conquistaron el primer lugar en el Campeonato Nacional, demostrando excelencia técnica y trabajo en equipo excepcional.",
        color: "purple",
    },
    {
        id: 2,
        image: "/achievement_programming_1770214990354.png",
        category: "Aprendizaje",
        title: "Dominando la Programación",
        description:
            "Desde sus primeras líneas de código hasta crear aplicaciones completas, nuestros estudiantes desarrollan habilidades que transforman ideas en realidad.",
        color: "lime",
    },
    {
        id: 3,
        image: "/achievement_innovation_1770215005972.png",
        category: "Innovación",
        title: "Presentando Soluciones Innovadoras",
        description:
            "Proyectos que abordan problemas reales con tecnología avanzada, presentados ante jueces y expertos en ferias científicas.",
        color: "orange",
    },
    {
        id: 4,
        image: "/achievement_teamwork_1770215022661.png",
        category: "Colaboración",
        title: "Construyendo Juntos el Futuro",
        description:
            "El trabajo en equipo es fundamental. Nuestros estudiantes aprenden a colaborar, comunicarse y crear soluciones extraordinarias.",
        color: "purple",
    },
    {
        id: 5,
        image: "/achievement_learning_1770215049333.png",
        category: "Experimentación",
        title: "Explorando la Electrónica",
        description:
            "Desde Arduino hasta sensores avanzados, los estudiantes experimentan con tecnología de punta, convirtiendo la teoría en proyectos tangibles.",
        color: "lime",
    },
    {
        id: 6,
        image: "/achievement_success_1770215047399.png",
        category: "Impacto Social",
        title: "Inspirando a la Próxima Generación",
        description:
            "Nuestros estudiantes se convierten en mentores, compartiendo su pasión por la tecnología y robótica con la comunidad.",
        color: "orange",
    },
];
---

<section id="achievements" class="achievements section-padding">
    <div class="container">
        <!-- Section Header -->
        <div class="achievements__header reveal">
            <h2 class="achievements__title">
                Logros que <span class="gradient-text">Inspiran</span>
            </h2>
            <p class="achievements__subtitle">
                Cada proyecto, cada competencia, cada línea de código representa
                el crecimiento y la transformación de nuestros estudiantes.
            </p>
        </div>

        <!-- Achievements Grid -->
        <div class="achievements__grid stagger-children">
            {
                achievements.map((achievement) => (
                    <article class="achievement-card reveal-scale">
                        <div class="achievement-card__image-wrapper">
                            <img
                                src={achievement.image}
                                alt={achievement.title}
                                class="achievement-card__image"
                                loading="lazy"
                            />
                            <div class="achievement-card__overlay" />
                        </div>

                        <div class="achievement-card__content">
                            <span
                                class={`achievement-card__badge achievement-card__badge--${achievement.color}`}
                            >
                                {achievement.category}
                            </span>

                            <h3 class="achievement-card__title">
                                {achievement.title}
                            </h3>

                            <p class="achievement-card__description">
                                {achievement.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* Achievements Section */
    .achievements {
        background: var(--color-light);
        position: relative;
    }

    /* Header */
    .achievements__header {
        text-align: center;
        max-width: 800px;
        margin: 0 auto var(--space-16);
    }

    .achievements__title {
        font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
        font-weight: 700;
        margin-bottom: var(--space-4);
        color: var(--color-dark);
    }

    .achievements__subtitle {
        font-size: var(--text-lg);
        color: var(--color-neutral-600);
        line-height: 1.7;
    }

    /* Grid */
    .achievements__grid {
        display: grid;
        gap: var(--space-8);
        grid-template-columns: 1fr;
    }

    @media (min-width: 768px) {
        .achievements__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1024px) {
        .achievements__grid {
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-10);
        }
    }

    /* Achievement Card */
    .achievement-card {
        background: white;
        border-radius: var(--radius-2xl);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        transition: all var(--transition-base);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .achievement-card:hover {
        transform: translateY(-8px);
        box-shadow: var(--shadow-xl);
    }

    .achievement-card__image-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--color-neutral-100);
    }

    .achievement-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-slow);
    }

    .achievement-card:hover .achievement-card__image {
        transform: scale(1.05);
    }

    .achievement-card__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.3) 0%,
            transparent 50%
        );
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .achievement-card:hover .achievement-card__overlay {
        opacity: 1;
    }

    .achievement-card__content {
        padding: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        flex-grow: 1;
    }

    .achievement-card__badge {
        display: inline-flex;
        width: fit-content;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .achievement-card__badge--purple {
        background: rgba(139, 92, 246, 0.1);
        color: var(--color-secondary);
    }

    .achievement-card__badge--lime {
        background: rgba(132, 204, 22, 0.1);
        color: var(--color-accent-green);
    }

    .achievement-card__badge--orange {
        background: rgba(255, 76, 36, 0.1);
        color: var(--color-primary);
    }

    .achievement-card__title {
        font-size: var(--text-xl);
        font-weight: 700;
        color: var(--color-dark);
        line-height: 1.3;
    }

    .achievement-card__description {
        font-size: var(--text-sm);
        color: var(--color-neutral-600);
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* Responsive Adjustments */
    @media (max-width: 640px) {
        .achievements__grid {
            gap: var(--space-6);
        }

        .achievement-card__content {
            padding: var(--space-5);
        }

        .achievement-card__title {
            font-size: var(--text-lg);
        }
    }
</style>

<script>
    // Scroll reveal animations
    document.addEventListener("DOMContentLoaded", () => {
        const reveals = document.querySelectorAll(".reveal, .reveal-scale");
        const staggerContainers =
            document.querySelectorAll(".stagger-children");

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                    }
                });
            },
            { threshold: 0.1 },
        );

        reveals.forEach((el) => observer.observe(el));
        staggerContainers.forEach((el) => observer.observe(el));
    });
</script>
