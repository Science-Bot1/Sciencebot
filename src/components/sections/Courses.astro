---
import SectionHeader from "../ui/SectionHeader.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

const courses = [
    {
        id: "lego-robotics",
        title: "Robótica LEGO",
        description:
            "Construcción y programación con LEGO Mindstorms. Los niños crean robots que caminan, agarran objetos y siguen líneas.",
        ageRange: "6-10 años",
        level: "Principiante",
        duration: "3 meses",
        color: "#F97316",
        url: "/cursos/robotica-lego",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="lego-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#FF8C42;stop-opacity:1" /><stop offset="100%" style="stop-color:#F97316;stop-opacity:1" /></linearGradient></defs><rect x="4" y="12" width="16" height="8" rx="1.5" fill="url(#lego-grad)"/><rect x="5" y="5" width="6" height="8" rx="1.5" fill="url(#lego-grad)" opacity="0.8"/><rect x="13" y="7" width="6" height="6" rx="1.5" fill="url(#lego-grad)" opacity="0.9"/><circle cx="8" cy="8" r="1" fill="white" opacity="0.9"/><circle cx="16" cy="10" r="1" fill="white" opacity="0.9"/><circle cx="8" cy="15" r="1.2" fill="white" opacity="0.8"/><circle cx="12" cy="15" r="1.2" fill="white" opacity="0.8"/><circle cx="16" cy="15" r="1.2" fill="white" opacity="0.8"/></svg>`,
    },
    {
        id: "scratch-jr",
        title: "Scratch Jr",
        description:
            "Introducción visual a la lógica de programación. Crean historias interactivas y juegos simples arrastrando bloques.",
        ageRange: "6-8 años",
        level: "Principiante",
        duration: "2 meses",
        color: "#06B6D4",
        url: "/cursos/scratch-jr",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="scratchjr-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#22D3EE;stop-opacity:1" /><stop offset="100%" style="stop-color:#06B6D4;stop-opacity:1" /></linearGradient></defs><path d="M7 4h6c1.1 0 2 .9 2 2v2h2c1.1 0 2 .9 2 2v6c0 1.1-.9 2-2 2h-2v2c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2v-6c0-1.1.9-2 2-2h2V8c0-1.1-.9-2-2-2z" fill="url(#scratchjr-grad)"/><rect x="6" y="5" width="6" height="6" rx="1" fill="white" opacity="0.3"/><rect x="12" y="9" width="6" height="6" rx="1" fill="white" opacity="0.25"/><rect x="6" y="13" width="6" height="6" rx="1" fill="white" opacity="0.2"/><circle cx="9" cy="8" r="1" fill="white"/><circle cx="15" cy="12" r="1" fill="white"/><circle cx="9" cy="16" r="1" fill="white"/></svg>`,
    },
    {
        id: "scratch",
        title: "Scratch",
        description:
            "Programación visual avanzada. Desarrollan videojuegos, animaciones y aplicaciones interactivas completas.",
        ageRange: "8-12 años",
        level: "Intermedio",
        duration: "4 meses",
        color: "#F59E0B",
        url: "/cursos/scratch",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="scratch-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#FCD34D;stop-opacity:1" /><stop offset="100%" style="stop-color:#F59E0B;stop-opacity:1" /></linearGradient></defs><path d="M5 8l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)" opacity="0.9"/><path d="M11 8l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)"/><path d="M5 14l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)"/><path d="M11 14l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)" opacity="0.85"/><path d="M5 20l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)" opacity="0.8"/><path d="M17 14l3-3 3 3-3 3-3-3z" fill="url(#scratch-grad)" opacity="0.75"/></svg>`,
    },
    {
        id: "python",
        title: "Python",
        description:
            "Programación textual real. Aprenden el lenguaje más demandado creando juegos, chatbots y proyectos de IA.",
        ageRange: "10-17 años",
        level: "Intermedio",
        duration: "6 meses",
        color: "#2563EB",
        url: "/cursos/python",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="python-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#60A5FA;stop-opacity:1" /><stop offset="100%" style="stop-color:#2563EB;stop-opacity:1" /></linearGradient></defs><path d="M12 3C8.5 3 7 4.5 7 7v3h5v1H6c-1.5 0-3 1-3 3.5S4.5 18 6 18h2v-2.5c0-1.5 1-2.5 2.5-2.5h5c1.5 0 2.5-1 2.5-2.5V7c0-2-1-4-4.5-4H12z" fill="url(#python-grad)"/><circle cx="9.5" cy="6.5" r="1" fill="white"/><path d="M12 21c3.5 0 5-1.5 5-4v-3h-5v-1h6c1.5 0 3-1 3-3.5S19.5 6 18 6h-2v2.5c0 1.5-1 2.5-2.5 2.5h-5C7 11 6 12 6 13.5V17c0 2 1 4 4.5 4H12z" fill="url(#python-grad)" opacity="0.85"/><circle cx="14.5" cy="17.5" r="1" fill="white"/></svg>`,
    },
    {
        id: "arduino",
        title: "Arduino",
        description:
            "Electrónica y programación de hardware. Construyen proyectos IoT, robots autónomos y sistemas automatizados.",
        ageRange: "12-17 años",
        level: "Avanzado",
        duration: "6 meses",
        color: "#10B981",
        url: "/cursos/arduino",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="arduino-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#34D399;stop-opacity:1" /><stop offset="100%" style="stop-color:#10B981;stop-opacity:1" /></linearGradient></defs><rect x="4" y="4" width="16" height="16" rx="2" fill="url(#arduino-grad)"/><rect x="6" y="6" width="12" height="4" rx="1" fill="white" opacity="0.3"/><circle cx="8" cy="8" r="0.8" fill="white"/><circle cx="11" cy="8" r="0.8" fill="white"/><circle cx="14" cy="8" r="0.8" fill="white"/><circle cx="17" cy="8" r="0.8" fill="white"/><rect x="7" y="12" width="2" height="6" rx="0.5" fill="white" opacity="0.9"/><rect x="11" y="13" width="2" height="5" rx="0.5" fill="white" opacity="0.8"/><rect x="15" y="14" width="2" height="4" rx="0.5" fill="white" opacity="0.7"/><line x1="4" y1="11" x2="20" y2="11" stroke="white" stroke-width="0.5" opacity="0.4"/></svg>`,
    },
    {
        id: "web-dev",
        title: "Desarrollo Web",
        description:
            "Creación de páginas web profesionales con HTML, CSS y JavaScript. Publican sus propios sitios en internet.",
        ageRange: "14-17 años",
        level: "Avanzado",
        duration: "6 meses",
        color: "#7C3AED",
        url: "/cursos/desarrollo-web",
        icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="web-grad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#A78BFA;stop-opacity:1" /><stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" /></linearGradient></defs><rect x="3" y="4" width="18" height="16" rx="2" fill="url(#web-grad)"/><rect x="3" y="4" width="18" height="4" rx="2" fill="white" opacity="0.2"/><circle cx="6" cy="6" r="0.8" fill="white"/><circle cx="8.5" cy="6" r="0.8" fill="white"/><circle cx="11" cy="6" r="0.8" fill="white"/><path d="M7 12l2 2-2 2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/><line x1="11" y1="16" x2="15" y2="16" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/><path d="M7 11h10M7 13h8" stroke="white" stroke-width="0.5" opacity="0.3"/></svg>`,
    },
];
---

<section id="courses" class="courses section-padding">
    <div class="container">
        <SectionHeader
            label="Nuestros Programas"
            title="Cursos diseñados para <span class='gradient-text'>despertar la creatividad</span> tecnológica"
            subtitle="Desde los primeros pasos en robótica hasta proyectos avanzados de programación"
            align="center"
        />

        <div class="courses__carousel-container reveal">
            <div
                class="courses__carousel stagger-children"
                id="courses-carousel"
            >
                {
                    courses.map((course) => (
                        <div class="courses__card-wrapper">
                            <Card
                                variant="default"
                                padding="lg"
                                hover={true}
                                class="courses__card"
                            >
                                <div
                                    class="courses__card-header"
                                    style={`--course-color: ${course.color}`}
                                >
                                    <div
                                        class="courses__card-icon"
                                        set:html={course.icon}
                                    />
                                    <div class="courses__card-badges">
                                        <span class="courses__badge courses__badge--age">
                                            {course.ageRange}
                                        </span>
                                        <span class="courses__badge courses__badge--level">
                                            {course.level}
                                        </span>
                                    </div>
                                </div>
                                <div class="courses__card-content">
                                    <h3 class="courses__card-title">
                                        {course.title}
                                    </h3>
                                    <p class="courses__card-description">
                                        {course.description}
                                    </p>
                                    <div class="courses__card-meta">
                                        <span class="courses__meta-item">
                                            <svg
                                                width="16"
                                                height="16"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <circle
                                                    cx="12"
                                                    cy="12"
                                                    r="10"
                                                />
                                                <path d="M12 6v6l4 2" />
                                            </svg>
                                            {course.duration}
                                        </span>
                                    </div>
                                    <Button
                                        href={course.url}
                                        variant="secondary"
                                        size="sm"
                                        class="courses__card-cta"
                                    >
                                        Más información
                                    </Button>
                                </div>
                            </Card>
                        </div>
                    ))
                }
            </div>

            <!-- Navigation Arrows -->
            <button
                class="courses__nav courses__nav--prev"
                aria-label="Curso anterior"
                id="courses-prev"
            >
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>
            <button
                class="courses__nav courses__nav--next"
                aria-label="Siguiente curso"
                id="courses-next"
            >
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>

        <!-- Pagination dots -->
        <div class="courses__pagination" id="courses-pagination">
            {
                courses
                    .slice(0, 4)
                    .map((_, index) => (
                        <button
                            class={`courses__dot ${index === 0 ? "active" : ""}`}
                            data-index={index}
                            aria-label={`Ir al curso ${index + 1}`}
                        />
                    ))
            }
        </div>
    </div>
</section>

<style>
    .courses {
        background: var(--color-light);
        overflow: hidden;
    }

    .courses__carousel-container {
        position: relative;
        margin: 0 calc(-1 * var(--space-4));
        padding: 0 var(--space-4);
    }

    @media (min-width: 1024px) {
        .courses__carousel-container {
            margin: 0;
            padding: 0;
        }
    }

    .courses__carousel {
        display: flex;
        gap: var(--space-6);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding: var(--space-4) 0;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .courses__carousel::-webkit-scrollbar {
        display: none;
    }

    .courses__card-wrapper {
        flex: 0 0 300px;
        scroll-snap-align: center;
        opacity: 0;
        transform: translateY(30px) scale(0.95);
        animation: cardSlideIn 0.6s ease forwards;
        animation-delay: calc(var(--card-index, 0) * 0.1s);
    }

    .courses__card-wrapper:nth-child(1) {
        --card-index: 0;
    }
    .courses__card-wrapper:nth-child(2) {
        --card-index: 1;
    }
    .courses__card-wrapper:nth-child(3) {
        --card-index: 2;
    }
    .courses__card-wrapper:nth-child(4) {
        --card-index: 3;
    }
    .courses__card-wrapper:nth-child(5) {
        --card-index: 4;
    }
    .courses__card-wrapper:nth-child(6) {
        --card-index: 5;
    }

    @keyframes cardSlideIn {
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (min-width: 768px) {
        .courses__card-wrapper {
            flex: 0 0 320px;
        }
    }

    @media (min-width: 1024px) {
        .courses__card-wrapper {
            flex: 0 0 calc((100% - (2 * var(--space-6))) / 3);
        }
    }

    .courses__card {
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .courses__card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px -10px rgba(139, 92, 246, 0.2);
    }

    .courses__card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--space-4);
    }

    .courses__card-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: linear-gradient(
            135deg,
            var(--course-color, var(--color-primary)) 0%,
            color-mix(
                    in srgb,
                    var(--course-color, var(--color-primary)) 80%,
                    black
                )
                100%
        );
        border-radius: var(--radius-lg);
        color: white;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .courses__card:hover .courses__card-icon {
        transform: scale(1.1) rotate(5deg);
        box-shadow: 0 8px 20px -5px var(--course-color, var(--color-primary));
    }

    .courses__card-badges {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        align-items: flex-end;
    }

    .courses__badge {
        display: inline-block;
        padding: var(--space-1) var(--space-2);
        font-size: var(--text-xs);
        font-weight: 500;
        border-radius: var(--radius-sm);
        transition: transform 0.2s ease;
    }

    .courses__card:hover .courses__badge {
        transform: translateX(-4px);
    }

    .courses__badge--age {
        background: var(--color-accent-lime);
        color: var(--color-dark);
        font-weight: 600;
    }

    .courses__badge--level {
        background: rgba(139, 92, 246, 0.12);
        color: var(--color-secondary);
    }

    .courses__card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .courses__card-title {
        font-size: var(--text-xl);
        font-weight: 700;
        color: var(--color-dark);
        margin-bottom: var(--space-2);
        transition: color 0.3s ease;
    }

    .courses__card:hover .courses__card-title {
        color: var(--color-secondary);
    }

    .courses__card-description {
        font-size: var(--text-sm);
        color: var(--color-neutral-600);
        line-height: 1.6;
        flex: 1;
        margin-bottom: var(--space-4);
    }

    .courses__card-meta {
        display: flex;
        gap: var(--space-4);
        margin-bottom: var(--space-4);
        padding-bottom: var(--space-4);
        border-bottom: 1px solid var(--color-neutral-200);
    }

    .courses__meta-item {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--text-sm);
        color: var(--color-neutral-500);
    }

    .courses__card-cta {
        width: 100%;
        transition: all 0.3s ease;
    }

    .courses__card:hover .courses__card-cta {
        transform: translateY(-2px);
    }

    /* Navigation */
    .courses__nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 48px;
        height: 48px;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--color-neutral-200);
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--shadow-sm);
        z-index: 10;
        backdrop-filter: blur(4px);
        color: var(--color-neutral-600);
    }

    @media (min-width: 1024px) {
        .courses__nav {
            display: flex;
        }
    }

    .courses__nav:hover {
        background: var(--color-primary);
        border-color: var(--color-primary);
        color: white;
        transform: translateY(-50%) scale(1.1);
        box-shadow: var(--shadow-md);
    }

    .courses__nav:active {
        transform: translateY(-50%) scale(0.95);
    }

    .courses__nav--prev {
        left: -24px;
    }

    .courses__nav--next {
        right: -24px;
    }

    .courses__nav svg {
        transition: transform 0.2s ease;
    }

    .courses__nav--prev:hover svg {
        transform: translateX(-2px);
    }

    .courses__nav--next:hover svg {
        transform: translateX(2px);
    }

    .courses__pagination {
        display: flex;
        justify-content: center;
        gap: var(--space-2);
        margin-top: var(--space-8);
    }

    .courses__dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--color-neutral-300);
        border: none;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .courses__dot:hover {
        background: var(--color-neutral-600);
        transform: scale(1.3);
    }

    .courses__dot.active {
        background: var(--color-neutral-600);
        transform: scale(1.2);
        width: 28px;
        border-radius: var(--radius-full);
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
</style>

<script>
    const carousel = document.getElementById("courses-carousel");
    const prevBtn = document.getElementById("courses-prev");
    const nextBtn = document.getElementById("courses-next");
    const dots = document.querySelectorAll(".courses__dot");

    let currentIndex = 0;
    const cardWidth = 350 + 24; // card width + gap

    function updateDots() {
        dots.forEach((dot, index) => {
            dot.classList.toggle("active", index === currentIndex);
        });
    }

    function scrollToCard(index: number) {
        if (carousel) {
            carousel.scrollTo({
                left: index * cardWidth,
                behavior: "smooth",
            });
            currentIndex = index;
            updateDots();
        }
    }

    prevBtn?.addEventListener("click", () => {
        if (currentIndex > 0) {
            scrollToCard(currentIndex - 1);
        }
    });

    nextBtn?.addEventListener("click", () => {
        const maxIndex = dots.length - 1;
        if (currentIndex < maxIndex) {
            scrollToCard(currentIndex + 1);
        }
    });

    dots.forEach((dot) => {
        dot.addEventListener("click", () => {
            const index = parseInt(dot.getAttribute("data-index") || "0");
            scrollToCard(index);
        });
    });

    // Update dots on scroll
    carousel?.addEventListener("scroll", () => {
        const scrollLeft = carousel.scrollLeft;
        const newIndex = Math.round(scrollLeft / cardWidth);
        if (newIndex !== currentIndex) {
            currentIndex = newIndex;
            updateDots();
        }
    });
</script>
