---
import Button from "../ui/Button.astro";
import StackedCarousel from "../carousel/StackedCarousel.astro";

const stats = [
    { value: "300+", label: "Estudiantes activos" },
    { value: "98%", label: "Padres satisfechos" },
];

const techIcons = [
    { name: "Robot", delay: "0s", x: "10%", y: "20%" },
    { name: "Code", delay: "0.5s", x: "85%", y: "15%" },
    { name: "Chip", delay: "1s", x: "5%", y: "70%" },
    { name: "Gear", delay: "1.5s", x: "90%", y: "65%" },
    { name: "Lego", delay: "2s", x: "15%", y: "50%" },
    { name: "Lego", delay: "2.5s", x: "80%", y: "40%" },
];
---

<section id="hero" class="hero">
    <!-- Background Elements -->
    <div class="hero__background">
        <div class="hero__gradient"></div>
        <div class="hero__grid"></div>

        <!-- Floating Tech Icons -->
        {
            techIcons.map((icon) => (
                <div
                    class="hero__floating-icon"
                    style={`left: ${icon.x}; top: ${icon.y}; animation-delay: ${icon.delay}`}
                    aria-hidden="true"
                >
                    <svg
                        width="40"
                        height="40"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        {icon.name === "Robot" && (
                            <>
                                <rect
                                    x="3"
                                    y="11"
                                    width="18"
                                    height="10"
                                    rx="2"
                                />
                                <circle cx="8.5" cy="16" r="1.5" />
                                <circle cx="15.5" cy="16" r="1.5" />
                                <path d="M12 11V8" />
                                <circle cx="12" cy="5" r="3" />
                            </>
                        )}
                        {icon.name === "Code" && (
                            <>
                                <polyline points="16,18 22,12 16,6" />
                                <polyline points="8,6 2,12 8,18" />
                            </>
                        )}
                        {icon.name === "Chip" && (
                            <>
                                <rect
                                    x="4"
                                    y="4"
                                    width="16"
                                    height="16"
                                    rx="2"
                                />
                                <rect x="9" y="9" width="6" height="6" />
                                <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
                            </>
                        )}
                        {icon.name === "Gear" && (
                            <>
                                <circle cx="12" cy="12" r="3" />
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                            </>
                        )}
                        {icon.name === "Lego" && (
                            <>
                                {/* Base block */}
                                <rect
                                    x="1"
                                    y="14"
                                    width="22"
                                    height="8"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                {/* Top block left */}
                                <rect
                                    x="2"
                                    y="6"
                                    width="8"
                                    height="9"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                {/* Top block right */}
                                <rect
                                    x="12"
                                    y="2"
                                    width="10"
                                    height="13"
                                    rx="1.5"
                                    stroke-width="2"
                                />
                                {/* Studs on base */}
                                <rect
                                    x="4"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="10"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="17"
                                    y="11.5"
                                    width="2.5"
                                    height="2.5"
                                    rx="0.8"
                                    stroke-width="1.5"
                                />
                                {/* Studs on left block */}
                                <rect
                                    x="4"
                                    y="3.5"
                                    width="2"
                                    height="2"
                                    rx="0.6"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="7.5"
                                    y="3.5"
                                    width="2"
                                    height="2"
                                    rx="0.6"
                                    stroke-width="1.5"
                                />
                                {/* Studs on right block */}
                                <rect
                                    x="14"
                                    y="0"
                                    width="2"
                                    height="1.5"
                                    rx="0.5"
                                    stroke-width="1.5"
                                />
                                <rect
                                    x="18"
                                    y="0"
                                    width="2"
                                    height="1.5"
                                    rx="0.5"
                                    stroke-width="1.5"
                                />
                                {/* Detail line */}
                                <line
                                    x1="5"
                                    y1="18"
                                    x2="10"
                                    y2="18"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                />
                            </>
                        )}
                    </svg>
                </div>
            ))
        }
    </div>

    <div class="hero__container container">
        <div class="hero__content stagger-children">
            <!-- Badge -->
            <div class="hero__badge">
                <span class="hero__badge-dot"></span>
                <span>Academia Online de Robótica</span>
            </div>

            <!-- Headline -->
            <h1 class="hero__title">
                Despierta el genio tecnológico de tu hijo
            </h1>

            <!-- Subtitle -->
            <p class="hero__subtitle">
                Cursos de robótica y programación diseñados para niños y
                adolescentes de 6 a 17 años. Aprenden creando, experimentando y
                divirtiéndose.
            </p>

            <!-- CTA Buttons -->
            <div class="hero__cta">
                <Button href="#courses" variant="primary" size="lg">
                    Ver Cursos
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </Button>
                <Button href="/contacto" variant="outline" size="lg">
                    Clase de Prueba Gratis
                </Button>
            </div>

            <!-- Stats -->
            <div class="hero__stats">
                {
                    stats.map((stat) => (
                        <div class="hero__stat">
                            <span class="hero__stat-value">{stat.value}</span>
                            <span class="hero__stat-label">{stat.label}</span>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="hero__visual">
            <StackedCarousel />
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="hero__scroll">
        <div class="hero__scroll-icon">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
        </div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100vh;
        max-width: 100vw;
        display: flex;
        align-items: center;
        overflow: hidden;
        padding-top: 72px;
        /* Forzar azul para esta sección hero */
        --gradient-text: linear-gradient(
            135deg,
            #1616a8 0%,
            #2020e8 50%,
            #5c5cff 100%
        );
    }

    /* Background */
    .hero__background {
        position: absolute;
        inset: 0;
        z-index: -1;
        max-width: 100%;
        overflow: hidden;
    }

    .hero__gradient {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 80% 50% at 50% -20%,
                var(--color-primary-alpha-10) 0%,
                transparent 60%
            ),
            radial-gradient(
                ellipse 60% 40% at 80% 60%,
                var(--color-accent-alpha-5) 0%,
                transparent 50%
            );
    }

    .hero__grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(var(--color-primary-alpha-5) 1px, transparent 1px),
            linear-gradient(
                90deg,
                var(--color-primary-alpha-5) 1px,
                transparent 1px
            );
        background-size: 50px 50px;
        mask-image: radial-gradient(
            ellipse 80% 60% at 50% 50%,
            black 20%,
            transparent 70%
        );
    }

    .hero__floating-icon {
        position: absolute;
        color: var(--color-primary-light);
        opacity: 0.15;
        animation: float 4s ease-in-out infinite;
    }

    @media (max-width: 374px) {
        .hero__floating-icon {
            display: none;
        }
    }

    /* Container */
    .hero__container {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-10);
        padding: var(--space-8) 0;
        margin: 0 auto;
    }

    @media (min-width: 1024px) {
        .hero__container {
            grid-template-columns: 1fr 1fr;
            align-items: center;
        }
    }

    /* Content */
    .hero__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        text-align: left;
        align-items: flex-start;
        width: 100%;
    }

    .hero__badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-full);
        font-size: var(--text-sm);
        font-weight: 500;
        color: var(--color-neutral-600);
        width: fit-content;
    }

    .hero__badge-dot {
        width: 8px;
        height: 8px;
        background: var(--color-accent-lime);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
    }

    .hero__title {
        font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--color-dark);
    }

    .hero__title :global(.gradient-text) {
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
    }

    .hero__subtitle {
        font-size: var(--text-lg);
        color: var(--color-neutral-600);
        max-width: 50ch;
    }

    .hero__cta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        justify-content: flex-start;
    }

    .hero__stats {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8);
        justify-content: flex-start;
        padding-top: var(--space-6);
        border-top: 1px solid var(--color-neutral-200);
        margin-top: var(--space-4);
    }

    .hero__stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .hero__stat-value {
        font-size: var(--text-2xl);
        font-weight: 700;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        color: transparent;
    }

    .hero__stat-label {
        font-size: var(--text-sm);
        color: var(--color-neutral-500);
    }

    /* Visual */
    .hero__visual {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: visible;
    }

    .hero__image-wrapper {
        position: relative;
        width: 100%;
        max-width: 900px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-2xl);
        overflow: hidden;
    }

    .hero__robot-image {
        width: 100%;
        height: auto;
        max-height: 280px;
        object-fit: contain;
        animation: float 3s ease-in-out infinite;
        filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.15));
    }

    @media (min-width: 768px) {
        .hero__robot-image {
            max-height: 380px;
        }
    }

    @media (min-width: 1024px) {
        .hero__robot-image {
            max-height: 480px;
        }
    }

    .hero__robot {
        width: 200px;
        height: 200px;
        animation: float 3s ease-in-out infinite;
        z-index: 1;
    }

    @media (min-width: 768px) {
        .hero__robot {
            width: 250px;
            height: 250px;
        }
    }

    .hero__ring {
        position: absolute;
        border-radius: 50%;
        border: 2px solid;
    }

    .hero__ring--1 {
        width: 100%;
        height: 100%;
        border-color: var(--color-primary-alpha-20);
        animation: rotate 20s linear infinite;
    }

    .hero__ring--2 {
        width: 80%;
        height: 80%;
        border-color: var(--color-primary-alpha-15);
        animation: rotate 15s linear infinite reverse;
    }

    .hero__ring--3 {
        width: 60%;
        height: 60%;
        border-color: var(--color-accent-alpha-10);
        animation: rotate 10s linear infinite;
    }

    /* Scroll indicator */
    .hero__scroll {
        position: absolute;
        bottom: var(--space-6);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-primary);
        font-size: var(--text-sm);
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        cursor: pointer;
        opacity: 0.75;
        transition: opacity var(--transition-base);
    }

    .hero__scroll:hover {
        opacity: 1;
    }

    .hero__scroll-icon {
        animation: bounce 2s ease-in-out infinite;
        color: var(--color-primary);
    }

    @keyframes bounce {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(6px);
        }
    }

    /* Hide Spline watermark */
    .hero__spline-wrapper :global(a[href*="spline"]),
    .hero__spline-wrapper :global([data-spline-watermark]),
    .hero__spline-wrapper
        :global(div[style*="position: absolute"][style*="bottom"]) {
        display: none !important;
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }
</style>
