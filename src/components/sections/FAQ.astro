---
import SectionHeader from "../ui/SectionHeader.astro";
import Accordion from "../ui/Accordion.astro";

const faqCategories = [
    {
        category: "Inscripción",
        questions: [
            {
                question: "¿Cómo puedo inscribir a mi hijo?",
                answer: "El proceso es muy sencillo. Puedes completar el formulario de contacto en nuestra página, llamarnos directamente o escribirnos por WhatsApp. Te contactaremos para agendar una clase de prueba gratuita y resolver todas tus dudas.",
            },
            {
                question: "¿Ofrecen clase de prueba gratuita?",
                answer: "Sí, ofrecemos una clase de prueba completamente gratuita y sin compromiso. Es la mejor manera de que tu hijo conozca nuestra metodología y decida si le gusta antes de inscribirse.",
            },
            {
                question: "¿Cuáles son las formas de pago aceptadas?",
                answer: "Aceptamos transferencias bancarias y pagos en efectivo.",
            },
        ],
    },
    {
        category: "Clases",
        questions: [
            {
                question: "¿Las clases son presenciales u online?",
                answer: "Actualmente todas nuestras clases son 100% online en vivo. Utilizamos plataformas interactivas que permiten a los estudiantes colaborar, compartir pantalla y trabajar en proyectos en tiempo real con sus compañeros y profesores.",
            },
            {
                question: "¿Cuántos estudiantes hay por grupo?",
                answer: "Los grupos tienen un máximo de 8 estudiantes, aunque en los planes premium pueden ser de 4-6. Esto garantiza atención personalizada y que cada niño pueda avanzar a su ritmo.",
            },
            {
                question: "¿Qué pasa si mi hijo falta a una clase?",
                answer: "Grabamos todas las sesiones para que puedan verlas después. Además, ofrecemos clases de recuperación una vez al mes donde pueden repasar temas o completar proyectos pendientes.",
            },
            {
                question: "¿Qué equipo necesita mi hijo?",
                answer: "Solo necesitan una computadora con conexión a internet estable, cámara web y micrófono. Para cursos de Arduino enviamos los kits a domicilio con un costo adicional opcional.",
            },
        ],
    },
    {
        category: "Metodología",
        questions: [
            {
                question: "¿Los cursos tienen algún prerequisito?",
                answer: "No se requieren conocimientos previos para los cursos de nivel principiante. Para cursos intermedios y avanzados, recomendamos haber completado los niveles anteriores o tener experiencia equivalente.",
            },
            {
                question: "¿Cómo evalúan el progreso de los estudiantes?",
                answer: "Evaluamos a través de proyectos prácticos, no exámenes tradicionales. Cada módulo culmina con un proyecto que demuestra las habilidades adquiridas. Los padres reciben informes de progreso mensuales.",
            },
            {
                question: "¿Entregan certificados?",
                answer: "Sí, al completar cada curso los estudiantes reciben un certificado digital. Los cursos avanzados incluyen certificaciones adicionales reconocidas que pueden incluir en su portafolio.",
            },
        ],
    },
];
---

<section id="faq" class="faq dark-section section-padding">
    <div class="container">
        <SectionHeader
            label="Preguntas Frecuentes"
            title="Resolvemos todas tus <span class='gradient-text'>dudas</span>"
            subtitle="Si no encuentras la respuesta que buscas, contáctanos"
            align="center"
            dark={true}
        />

        <div class="faq__content">
            {
                faqCategories.map((category) => (
                    <div class="faq__category reveal">
                        <h3 class="faq__category-title">{category.category}</h3>
                        <div class="faq__list">
                            {category.questions.map((item) => (
                                <Accordion
                                    title={item.question}
                                    class="faq__accordion"
                                    dark={true}
                                >
                                    <p>{item.answer}</p>
                                </Accordion>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- CTA -->
        <div class="faq__cta reveal">
            <p class="faq__cta-text">¿Tienes más preguntas?</p>
            <a href="/contacto" class="faq__cta-link">
                Contáctanos
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    .faq {
        position: relative;
    }

    .faq::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse 60% 40% at 80% 20%,
                var(--color-primary-alpha-10) 0%,
                transparent 50%
            ),
            radial-gradient(
                ellipse 40% 30% at 20% 80%,
                var(--color-accent-alpha-5) 0%,
                transparent 50%
            );
        pointer-events: none;
    }

    .faq__content {
        display: grid;
        gap: var(--space-10);
        max-width: 900px;
        margin: 0 auto;
    }

    .faq__category-title {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-accent);
        margin-bottom: var(--space-4);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .faq__list {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .faq__accordion {
        background: #0f1115;
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .faq__accordion:hover {
        border-color: var(--color-primary-alpha-30);
        background: #1f2a3a;
        box-shadow: 0 4px 20px var(--color-primary-alpha-10);
    }

    :global(.faq__accordion .accordion__title) {
        color: #f1f5f9;
        font-size: var(--text-base);
        font-weight: 600;
    }

    :global(.faq__accordion .accordion__body) {
        color: #cbd5e1;
        line-height: 1.8;
        font-size: var(--text-base);
    }

    :global(.faq__accordion .accordion__body p) {
        margin: 0;
        color: #cbd5e1;
    }

    :global(.faq__accordion .accordion__chevron) {
        color: #94a3b8;
        transition:
            transform 0.3s ease,
            color 0.3s ease;
    }

    :global(.faq__accordion:hover .accordion__chevron) {
        color: var(--color-primary-light);
    }

    :global(.faq__accordion .accordion__icon) {
        display: flex;
    }

    /* CTA */
    .faq__cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        margin-top: var(--space-12);
        padding-top: var(--space-8);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .faq__cta-text {
        font-size: var(--text-lg);
        color: #cbd5e1;
        margin: 0;
    }

    .faq__cta-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-accent);
        text-decoration: none;
        transition: all var(--transition-base);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-lg);
    }

    .faq__cta-link:hover {
        gap: var(--space-3);
        background: var(--color-accent-alpha-10);
    }

    .faq__cta-link svg {
        transition: transform var(--transition-base);
    }

    .faq__cta-link:hover svg {
        transform: translateX(4px);
    }
</style>
