---
import SectionHeader from "../ui/SectionHeader.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";

const newsItems = [
    {
        id: 1,
        title: "Nuevos cursos de Inteligencia Artificial para jóvenes",
        excerpt:
            "Lanzamos cursos introductorios de IA donde los estudiantes crearán sus propios chatbots y aprenderán machine learning de forma práctica y divertida.",
        date: "2025-01-16",
        category: "Nuevos Cursos",
        image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&h=400&fit=crop",
        featured: true,
    },
    {
        id: 2,
        title: "Campamento de verano 2025: Robótica Intensiva",
        excerpt:
            "Este verano ofrecemos campamentos intensivos de una semana donde construirás y programarás robots desde cero. ¡Cupos limitados!",
        date: "2025-01-09",
        category: "Eventos",
        image: "https://images.unsplash.com/photo-1485827404703-89b55fcc595e?w=600&h=400&fit=crop",
        featured: false,
    },
    {
        id: 3,
        title: "Nuestros estudiantes ganan competencia regional",
        excerpt:
            "El equipo de robótica de ScienceBot obtuvo el primer lugar en la competencia regional FIRST LEGO League. ¡Estamos muy orgullosos!",
        date: "2025-01-04",
        category: "Logros",
        image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=600&h=400&fit=crop",
        featured: false,
    },
    {
        id: 4,
        title: "Realidad Virtual en el aula: El futuro es hoy",
        excerpt:
            "Incorporamos nuevas herramientas de realidad virtual para que los estudiantes exploren entornos de programación 3D.",
        date: "2024-12-28",
        category: "Tecnología",
        image: "https://images.unsplash.com/photo-1592478411213-6153e4ebc07d?w=600&h=400&fit=crop",
        featured: false,
    },
    {
        id: 5,
        title: "Apertura de inscripciones: Ciclo 2025",
        excerpt:
            "Ya están abiertas las inscripciones para todos nuestros cursos anuales. ¡Asegura tu lugar con descuento por inscripción temprana!",
        date: "2024-12-15",
        category: "Nuevos Cursos",
        image: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?w=600&h=400&fit=crop",
        featured: false,
    },
    {
        id: 6,
        title: "Taller gratuito: Introducción a la Programación",
        excerpt:
            "Invitamos a todos los interesados a nuestro taller gratuito introductorio. Aprende los fundamentos de la programación en un ambiente divertido.",
        date: "2024-12-10",
        category: "Eventos",
        image: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&h=400&fit=crop",
        featured: false,
    },
];

function formatDate(dateString: string): string {
    const date = new Date(dateString);
    return date.toLocaleDateString("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
    });
}
---

<section id="news" class="news dark-section section-padding">
    <div class="container">
        <SectionHeader
            label="Noticias"
            title="Últimas <span class='gradient-text'>novedades</span>"
            subtitle="Mantente al día con todo lo que pasa en ScienceBot"
            align="center"
            dark={true}
        />

        <div class="news__grid">
            {
                newsItems.map((item, index) => (
                    <article
                        class={`news__card ${item.featured ? "news__card--featured" : ""} reveal`}
                    >
                        <div class="news__image-wrapper">
                            <img
                                src={item.image}
                                alt={item.title}
                                class="news__image"
                                loading="lazy"
                            />
                            <span class="news__category">{item.category}</span>
                        </div>
                        <div class="news__content">
                            <time class="news__date" datetime={item.date}>
                                {formatDate(item.date)}
                            </time>
                            <h3 class="news__title">{item.title}</h3>
                            <p class="news__excerpt">{item.excerpt}</p>
                            <a href="#" class="news__link">
                                Leer más
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .news__grid {
        display: grid;
        gap: var(--space-6);
    }

    @media (min-width: 768px) {
        .news__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .news__card {
        background: #0f1115;
        border: 1px solid #ffffff1a;
        border-radius: var(--radius-xl);
        overflow: hidden;
        transition: all var(--transition-base);
    }

    .news__card:hover {
        border-color: var(--color-primary);
        transform: translateY(-4px);
        background: #1f2a3a;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    @media (min-width: 768px) {
        .news__card--featured {
            grid-column: span 2;
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .news__card--featured .news__image-wrapper {
            height: 100%;
        }
    }

    .news__image-wrapper {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

    .news__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-slow);
    }

    .news__card:hover .news__image {
        transform: scale(1.05);
    }

    .news__category {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        padding: var(--space-1) var(--space-3);
        background: var(--gradient-primary);
        color: white;
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: var(--radius-full);
    }

    .news__content {
        padding: var(--space-6);
    }

    .news__date {
        display: block;
        font-size: var(--text-sm);
        color: var(--color-neutral-500);
        margin-bottom: var(--space-2);
    }

    .news__title {
        font-size: var(--text-lg);
        font-weight: 600;
        color: white;
        margin-bottom: var(--space-3);
        line-height: 1.4;
    }

    .news__card--featured .news__title {
        font-size: var(--text-xl);
    }

    .news__excerpt {
        font-size: var(--text-sm);
        color: var(--color-neutral-400);
        line-height: 1.6;
        margin-bottom: var(--space-4);
    }

    .news__link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        background: white;
        border-radius: var(--radius-full);
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-dark);
        text-decoration: none;
        transition: all var(--transition-base);
        box-shadow: var(--shadow-sm);
    }

    .news__link:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        gap: var(--space-2);
    }

    .news__link svg {
        transition: transform var(--transition-fast);
        color: var(--color-primary);
    }

    .news__link:hover svg {
        transform: translateX(2px);
    }
</style>
