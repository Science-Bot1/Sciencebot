---
import SectionHeader from "../ui/SectionHeader.astro";

const ceoInfo = {
    name: "Tatiana Muñoz",
    role: "CEO & Fundadora",
    bio: "Ingeniera en Electrónica con más de 15 años de experiencia en educación tecnológica. Apasionada por despertar la curiosidad científica en las nuevas generaciones.",
    quote: "Mi misión es democratizar la educación tecnológica, brindando a cada niño las herramientas para construir el futuro que imagina.",
    vision: "Fundé ScienceBot con una visión clara: crear un espacio donde la tecnología se convierta en un juego creativo. Donde cada robot construido sea una lección de perseverancia, cada línea de código una expresión de creatividad, y cada proyecto completado un paso hacia un futuro lleno de posibilidades.",
    experience: [
        "15+ años en educación tecnológica",
        "Especialista en robótica educativa",
        "Mentora de más de 500 estudiantes",
        "Ponente internacional en EdTech",
    ],
};
---

<section id="ceo" class="ceo section-padding">
    <div class="container">
        <SectionHeader
            label="Nuestra Historia"
            title="Conoce a la mente detrás de <span class='gradient-text'>ScienceBot</span>"
            subtitle="Una visión que transforma vidas a través de la tecnología"
            align="center"
        />

        <div class="ceo__content reveal">
            <div class="ceo__image-wrapper">
                <div class="ceo__image-container">
                    <img
                        src="/images/ceo.png"
                        alt="Tatiana Muñoz - CEO & Fundadora de ScienceBot"
                        class="ceo__image"
                    />
                    <div class="ceo__image-glow"></div>
                </div>
                <div class="ceo__credentials">
                    <h3 class="ceo__name">{ceoInfo.name}</h3>
                    <span class="ceo__role">{ceoInfo.role}</span>
                </div>
            </div>

            <div class="ceo__info">
                <blockquote class="ceo__quote">
                    <svg
                        class="ceo__quote-icon"
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16-.95.1-1.956.76-3.022.66-1.065 1.515-1.867 2.558-2.403L9.373 5c-.8.396-1.56.898-2.26 1.505-.71.607-1.34 1.305-1.9 2.094s-.98 1.68-1.25 2.69-.346 2.04-.217 3.1c.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l.002.003zm9.124 0c0-.88-.23-1.618-.69-2.217-.326-.42-.77-.692-1.327-.817-.56-.124-1.074-.13-1.54-.022-.16-.94.09-1.95.75-3.02.66-1.06 1.514-1.86 2.557-2.4L18.49 5c-.8.396-1.555.898-2.26 1.505-.708.607-1.34 1.305-1.894 2.094-.556.79-.97 1.68-1.24 2.69-.273 1-.345 2.04-.217 3.1.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l-.007.003z"
                        ></path>
                    </svg>
                    <p>{ceoInfo.quote}</p>
                </blockquote>

                <p class="ceo__bio">{ceoInfo.bio}</p>

                <p class="ceo__vision">{ceoInfo.vision}</p>

                <div class="ceo__experience">
                    <h4 class="ceo__experience-title">Trayectoria</h4>
                    <ul class="ceo__experience-list">
                        {
                            ceoInfo.experience.map((item) => (
                                <li class="ceo__experience-item">
                                    <svg
                                        width="20"
                                        height="20"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                    >
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                        <polyline points="22 4 12 14.01 9 11.01" />
                                    </svg>
                                    <span>{item}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .ceo {
        background: var(--color-light-secondary);
        position: relative;
        overflow: hidden;
        padding-top: var(--space-8);
    }

    @media (min-width: 768px) {
        .ceo {
            padding-top: var(--space-12);
        }
    }

    .ceo::before {
        content: "";
        position: absolute;
        top: 0;
        right: -20%;
        width: 50%;
        height: 100%;
        background: radial-gradient(
            ellipse 70% 50% at 70% 30%,
            rgba(37, 99, 235, 0.08) 0%,
            transparent 60%
        );
        pointer-events: none;
    }

    .ceo__content {
        display: grid;
        gap: var(--space-12);
        max-width: 1000px;
        margin: 0 auto;
        align-items: start;
    }

    @media (min-width: 768px) {
        .ceo__content {
            grid-template-columns: 300px 1fr;
            gap: var(--space-16);
        }
    }

    .ceo__image-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-6);
    }

    .ceo__image-container {
        position: relative;
        width: 220px;
        height: 220px;
    }

    .ceo__image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        object-position: center;
        box-shadow:
            0 20px 40px -10px rgba(37, 99, 235, 0.4),
            inset 0 -5px 20px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 2;
        border: 4px solid white;
        transition: transform 0.3s ease;
    }

    .ceo__image:hover {
        transform: scale(1.05);
    }

    .ceo__image-glow {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        background: linear-gradient(
            135deg,
            var(--color-primary),
            var(--color-secondary)
        );
        opacity: 0.3;
        filter: blur(20px);
        z-index: 1;
        animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
        0%,
        100% {
            transform: scale(1);
            opacity: 0.3;
        }
        50% {
            transform: scale(1.05);
            opacity: 0.4;
        }
    }

    .ceo__credentials {
        text-align: center;
    }

    .ceo__name {
        font-size: var(--text-2xl);
        font-weight: 700;
        color: var(--color-dark);
        margin-bottom: var(--space-1);
    }

    .ceo__role {
        display: inline-block;
        padding: var(--space-1) var(--space-4);
        background: var(--gradient-primary);
        color: white;
        font-size: var(--text-sm);
        font-weight: 600;
        border-radius: var(--radius-full);
    }

    .ceo__info {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .ceo__quote {
        position: relative;
        padding: var(--space-6);
        background: white;
        border-radius: var(--radius-2xl);
        border-left: 4px solid var(--color-primary);
        box-shadow: var(--shadow-lg);
    }

    .ceo__quote-icon {
        position: absolute;
        top: -16px;
        left: 24px;
        color: var(--color-primary);
        opacity: 0.2;
    }

    .ceo__quote p {
        font-size: var(--text-lg);
        font-style: italic;
        color: var(--color-dark);
        line-height: 1.7;
        margin: 0;
    }

    .ceo__bio {
        font-size: var(--text-base);
        color: var(--color-neutral-600);
        line-height: 1.7;
        margin: 0;
    }

    .ceo__vision {
        font-size: var(--text-base);
        color: var(--color-neutral-600);
        line-height: 1.8;
        margin: 0;
        padding: var(--space-4);
        background: rgba(37, 99, 235, 0.05);
        border-radius: var(--radius-xl);
        border: 1px solid rgba(37, 99, 235, 0.1);
    }

    .ceo__experience {
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-neutral-200);
    }

    .ceo__experience-title {
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--color-dark);
        margin-bottom: var(--space-4);
    }

    .ceo__experience-list {
        display: grid;
        gap: var(--space-3);
        list-style: none;
        padding: 0;
        margin: 0;
    }

    @media (min-width: 480px) {
        .ceo__experience-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .ceo__experience-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-sm);
        color: var(--color-neutral-600);
    }

    .ceo__experience-item svg {
        color: var(--color-accent-green);
        flex-shrink: 0;
    }
</style>
