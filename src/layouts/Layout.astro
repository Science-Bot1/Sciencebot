---
import "../styles/global.css";
import ScrollReveal from "../components/ui/ScrollReveal.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ScienceBot | Escuela de robótica del Guaviare",
  description = "Escuela de robótica de San José del Guaviare, Amazonía colombiana. Robótica, programación, impresión 3D y ciencia para niños y jóvenes de 6 a 17 años.",
} = Astro.props;

const siteUrl = "https://sciencebot.academy";
const ogImage = new URL("/logo-sciencebot.png", siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-sciencebot.png" />
    <link rel="shortcut icon" href="/logo-sciencebot.png" />
    <link rel="apple-touch-icon" href="/logo-sciencebot.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="robótica para niños, programación para jóvenes, LEGO robotics, Scratch, Python, Arduino, academia de robótica, cursos de programación"
    />
    <meta name="author" content="ScienceBot" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="568" />
    <meta property="og:site_name" content="ScienceBot" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Schema.org -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        name: "ScienceBot",
        description: description,
        url: siteUrl,
        logo: `${siteUrl}/logo-sciencebot.png`,
        email: "sciencebot2@gmail.com",
        telephone: "+57 318 841 4774",
        foundingDate: "2020",
        founder: { "@type": "Person", name: "Angie Tatiana Muñoz González" },
        address: {
          "@type": "PostalAddress",
          addressLocality: "San José del Guaviare",
          addressRegion: "Guaviare",
          addressCountry: "CO",
        },
        sameAs: [
          "https://www.facebook.com/ScienceBot1/",
          "https://www.instagram.com/science.bot/",
          "https://www.youtube.com/@sciencebot3400",
          "https://www.tiktok.com/@1sciencebot",
        ],
        offers: {
          "@type": "Offer",
          category: "Cursos de Robótica y Programación",
        },
        audience: {
          "@type": "EducationalAudience",
          educationalRole: "student",
          audienceType: "Niños y Adolescentes 6-17 años",
        },
      })}
    />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />

    <!-- Scroll Reveal Animations -->
    <ScrollReveal />
  </body>
</html>
